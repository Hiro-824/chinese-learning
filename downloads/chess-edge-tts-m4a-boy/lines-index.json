[
  {
    "id": "additional-2026-10-29-1-1",
    "zhHans": "我不喜欢输。",
    "audio": "audio/b85e55a3f2052246.m4a"
  },
  {
    "id": "additional-2026-10-29-1-2",
    "zhHans": "我不走！",
    "audio": "audio/5b7be9732690383b.m4a"
  },
  {
    "id": "additional-2026-10-29-1-3",
    "zhHans": "你也喜欢下棋吗？",
    "audio": "audio/a92d860a048f757d.m4a"
  },
  {
    "id": "additional-2026-10-29-1-4",
    "zhHans": "我也来了！",
    "audio": "audio/638f1eb44254352d.m4a"
  },
  {
    "id": "additional-2026-10-29-1-5",
    "zhHans": "我们都准备好了。",
    "audio": "audio/b2f5b157c5afb308.m4a"
  },
  {
    "id": "additional-2026-10-29-2-1",
    "zhHans": "咱们开始吧！",
    "audio": "audio/248c99f235e53932.m4a"
  },
  {
    "id": "additional-2026-10-29-2-2",
    "zhHans": "咱们再来一局！",
    "audio": "audio/2c7d8e6ba441063c.m4a"
  },
  {
    "id": "additional-2026-10-29-2-3",
    "zhHans": "咱们明天再玩吧！",
    "audio": "audio/c2c39baf01cd5f13.m4a"
  },
  {
    "id": "additional-2026-10-29-2-4",
    "zhHans": "你们准备好了吗？",
    "audio": "audio/7210b561ef36ff44.m4a"
  },
  {
    "id": "additional-2026-10-29-2-5",
    "zhHans": "你们真厉害！",
    "audio": "audio/ffc8d6663af31c6c.m4a"
  },
  {
    "id": "additional-2026-10-29-2-6",
    "zhHans": "你们起得真早！",
    "audio": "audio/0e18b09e3fe3335f.m4a"
  },
  {
    "id": "additional-2026-10-29-2-7",
    "zhHans": "大家准备好了吗？",
    "audio": "audio/5c289e35769e8f2d.m4a"
  },
  {
    "id": "additional-2026-10-29-2-8",
    "zhHans": "大家都笑我！",
    "audio": "audio/520fbabf375994b8.m4a"
  },
  {
    "id": "additional-2026-10-29-3-1",
    "zhHans": "她是我的朋友。",
    "audio": "audio/dc914f3c6587e430.m4a"
  },
  {
    "id": "additional-2026-10-29-3-2",
    "zhHans": "她跑得真快！",
    "audio": "audio/eb94c2a8b93efa51.m4a"
  },
  {
    "id": "additional-2026-10-29-3-3",
    "zhHans": "她回来了！",
    "audio": "audio/eb6da5135708131e.m4a"
  },
  {
    "id": "additional-2026-10-29-3-4",
    "zhHans": "她们都走了。",
    "audio": "audio/a20d66eb416f8121.m4a"
  },
  {
    "id": "additional-2026-10-29-3-5",
    "zhHans": "他们都走了。",
    "audio": "audio/01dc66fca0672ca1.m4a"
  },
  {
    "id": "additional-2026-10-29-3-6",
    "zhHans": "他们不在这里。",
    "audio": "audio/c47b47169eedc883.m4a"
  },
  {
    "id": "additional-2026-10-29-4-1",
    "zhHans": "它不见了！",
    "audio": "audio/ad0903e92d7ea70a.m4a"
  },
  {
    "id": "additional-2026-10-29-4-2",
    "zhHans": "它去哪儿了？",
    "audio": "audio/8190c5fe80138be4.m4a"
  },
  {
    "id": "additional-2026-10-29-4-3",
    "zhHans": "它变了！",
    "audio": "audio/12d496a8b76ec4d6.m4a"
  },
  {
    "id": "additional-2026-10-29-4-4",
    "zhHans": "它们去哪儿了？",
    "audio": "audio/754218007473c5e4.m4a"
  },
  {
    "id": "additional-2026-10-29-4-5",
    "zhHans": "我自己来！",
    "audio": "audio/aa92af92f0d54e46.m4a"
  },
  {
    "id": "additional-2026-10-29-4-6",
    "zhHans": "你自己来吗？",
    "audio": "audio/8b7801261ebd71ff.m4a"
  },
  {
    "id": "additional-2026-10-29-4-7",
    "zhHans": "别告诉别人！",
    "audio": "audio/4c17dfe0c72613d1.m4a"
  },
  {
    "id": "additional-2026-10-29-4-8",
    "zhHans": "人家不想输嘛！",
    "audio": "audio/68af555befe3cd8e.m4a"
  },
  {
    "id": "additional-2026-10-29-5-1",
    "zhHans": "你不是黑方。",
    "audio": "audio/8b4f194a7954f1da.m4a"
  },
  {
    "id": "additional-2026-10-29-5-2",
    "zhHans": "我不是黑方。",
    "audio": "audio/bed648e726c8f4f8.m4a"
  },
  {
    "id": "additional-2026-10-29-5-3",
    "zhHans": "这不是玩笑！",
    "audio": "audio/8c6bc654de9a77b8.m4a"
  },
  {
    "id": "additional-2026-10-29-5-4",
    "zhHans": "你是学生吗？",
    "audio": "audio/e08a47fa7ccf085a.m4a"
  },
  {
    "id": "additional-2026-10-29-5-5",
    "zhHans": "这是你的棋盘吗？",
    "audio": "audio/7acc32ff3e960a64.m4a"
  },
  {
    "id": "additional-2026-10-29-5-6",
    "zhHans": "这是你的计划吗？",
    "audio": "audio/c610131e9c5e2193.m4a"
  },
  {
    "id": "additional-2026-10-29-5-7",
    "zhHans": "我也是学生。",
    "audio": "audio/c3b17fac6e189d3d.m4a"
  },
  {
    "id": "additional-2026-10-29-5-8",
    "zhHans": "她也是王后！",
    "audio": "audio/766e88187d5304c9.m4a"
  },
  {
    "id": "additional-2026-10-29-5-9",
    "zhHans": "我们都是学生。",
    "audio": "audio/9b87cfef886e55ff.m4a"
  },
  {
    "id": "additional-2026-10-29-5-10",
    "zhHans": "我也不是每次都赢。",
    "audio": "audio/458c658b9ed09b7f.m4a"
  },
  {
    "id": "additional-2026-10-29-6-1",
    "zhHans": "这个很好！",
    "audio": "audio/ed3800a7b4da3dcc.m4a"
  },
  {
    "id": "additional-2026-10-29-6-2",
    "zhHans": "那个更好！",
    "audio": "audio/3a71a116fceb1548.m4a"
  },
  {
    "id": "additional-2026-10-29-6-3",
    "zhHans": "这个游戏真有趣！",
    "audio": "audio/d17c24a1ba314dcc.m4a"
  },
  {
    "id": "additional-2026-10-29-6-4",
    "zhHans": "那个办法真好！",
    "audio": "audio/4d1cf06f2e0de573.m4a"
  },
  {
    "id": "additional-2026-10-29-6-5",
    "zhHans": "你喜欢哪个？",
    "audio": "audio/e6981be6fbb0d210.m4a"
  },
  {
    "id": "additional-2026-10-29-6-6",
    "zhHans": "你要哪个？",
    "audio": "audio/c38e9ad19db11711.m4a"
  },
  {
    "id": "additional-2026-10-29-6-7",
    "zhHans": "哪匹马不见了？",
    "audio": "audio/d0719f008b7741af.m4a"
  },
  {
    "id": "additional-2026-10-29-6-8",
    "zhHans": "这些是谁的？",
    "audio": "audio/aabf42006a7b1f5e.m4a"
  },
  {
    "id": "additional-2026-10-29-6-9",
    "zhHans": "那些都是我的！",
    "audio": "audio/d705eb85558d156e.m4a"
  },
  {
    "id": "additional-2026-10-29-6-10",
    "zhHans": "这些是什么？",
    "audio": "audio/e3f6e5e4d8bcd71b.m4a"
  },
  {
    "id": "additional-2026-10-29-6-11",
    "zhHans": "哪些是你的？",
    "audio": "audio/cb54b9edeb593519.m4a"
  },
  {
    "id": "additional-2026-10-29-6-12",
    "zhHans": "那些兵都去哪儿了？",
    "audio": "audio/94341e247566d077.m4a"
  },
  {
    "id": "additional-2026-10-29-7-1",
    "zhHans": "这是中国的游戏吗？",
    "audio": "audio/6eb89341a365a378.m4a"
  },
  {
    "id": "additional-2026-10-29-7-2",
    "zhHans": "这是我的，你的是那个。",
    "audio": "audio/4318960a26610d51.m4a"
  },
  {
    "id": "additional-2026-10-29-7-3",
    "zhHans": "白色的是你的。",
    "audio": "audio/b26fc7a7a426adba.m4a"
  },
  {
    "id": "additional-2026-10-29-7-4",
    "zhHans": "黑色的是你的。",
    "audio": "audio/69dcef63c8b1d20a.m4a"
  },
  {
    "id": "additional-2026-10-29-7-5",
    "zhHans": "我的老师喜欢下棋。",
    "audio": "audio/2a3a8a1b15710e63.m4a"
  },
  {
    "id": "additional-2026-10-29-7-6",
    "zhHans": "我老师会生气的！",
    "audio": "audio/226eed25967dc529.m4a"
  },
  {
    "id": "additional-2026-10-29-7-7",
    "zhHans": "我们学校也有棋社。",
    "audio": "audio/00c7f21b0c1eee77.m4a"
  },
  {
    "id": "additional-2026-10-29-7-8",
    "zhHans": "我家有棋盘。",
    "audio": "audio/fb0bef5bc4f359b0.m4a"
  },
  {
    "id": "additional-2026-10-29-7-9",
    "zhHans": "这是一个重要的问题。",
    "audio": "audio/7760e847373919cf.m4a"
  },
  {
    "id": "additional-2026-10-29-7-10",
    "zhHans": "这是一个好办法！",
    "audio": "audio/0896b0fc52ed27d4.m4a"
  },
  {
    "id": "additional-2026-10-29-8-1",
    "zhHans": "你玩不玩？",
    "audio": "audio/3dc006bb53f04269.m4a"
  },
  {
    "id": "additional-2026-10-29-8-2",
    "zhHans": "你来不来？",
    "audio": "audio/e3e4f9a5fb463fd5.m4a"
  },
  {
    "id": "additional-2026-10-29-8-3",
    "zhHans": "你走不走？",
    "audio": "audio/4c2f5fce566f64d1.m4a"
  },
  {
    "id": "additional-2026-10-29-8-4",
    "zhHans": "你是不是学生？",
    "audio": "audio/dde131ed5b4455af.m4a"
  },
  {
    "id": "additional-2026-10-29-8-5",
    "zhHans": "这是不是将军？",
    "audio": "audio/e9acefcc6b57b823.m4a"
  },
  {
    "id": "additional-2026-10-29-8-6",
    "zhHans": "这是不是陷阱？",
    "audio": "audio/8a33b527836281dd.m4a"
  },
  {
    "id": "additional-2026-10-29-8-7",
    "zhHans": "你想不想再玩？",
    "audio": "audio/b78acc395168a482.m4a"
  },
  {
    "id": "additional-2026-10-29-8-8",
    "zhHans": "你下不下棋？",
    "audio": "audio/5c5ab24330a5fb7b.m4a"
  },
  {
    "id": "additional-2026-10-29-8-9",
    "zhHans": "你喝不喝水？",
    "audio": "audio/7c15b5496eaf715f.m4a"
  },
  {
    "id": "additional-2026-10-29-8-10",
    "zhHans": "你下棋不下？",
    "audio": "audio/c2d6955395de8b88.m4a"
  },
  {
    "id": "additional-2026-10-29-8-11",
    "zhHans": "你喝水不喝？",
    "audio": "audio/aa8aae5d10206efa.m4a"
  },
  {
    "id": "additional-2026-10-29-9-1",
    "zhHans": "这是什么？",
    "audio": "audio/d75442f5f1e6c817.m4a"
  },
  {
    "id": "additional-2026-10-29-9-2",
    "zhHans": "你想干什么？",
    "audio": "audio/59944bc1ee72a5be.m4a"
  },
  {
    "id": "additional-2026-10-29-9-3",
    "zhHans": "谁干的？",
    "audio": "audio/cfbc45e3be7b5d72.m4a"
  },
  {
    "id": "additional-2026-10-29-9-4",
    "zhHans": "谁教你的？",
    "audio": "audio/2f90e72fadd85939.m4a"
  },
  {
    "id": "additional-2026-10-29-9-5",
    "zhHans": "你的朋友在哪儿？",
    "audio": "audio/a1901168e9c4d9bd.m4a"
  },
  {
    "id": "additional-2026-10-29-9-6",
    "zhHans": "我的朋友去哪儿了？",
    "audio": "audio/0054b7e96ed49c43.m4a"
  },
  {
    "id": "additional-2026-10-29-9-7",
    "zhHans": "你什么时候回家？",
    "audio": "audio/b19ca9949a9d62f5.m4a"
  },
  {
    "id": "additional-2026-10-29-9-8",
    "zhHans": "你什么时候学的棋？",
    "audio": "audio/4fb1cbd0b25b942c.m4a"
  },
  {
    "id": "additional-2026-10-29-9-9",
    "zhHans": "为什么是她？",
    "audio": "audio/9e03975bdf99bb93.m4a"
  },
  {
    "id": "additional-2026-10-29-9-10",
    "zhHans": "为什么走这一步？",
    "audio": "audio/7c44eeb95ae49ef8.m4a"
  },
  {
    "id": "additional-2026-10-29-9-11",
    "zhHans": "今天怎么样？",
    "audio": "audio/a255d71334abf42a.m4a"
  },
  {
    "id": "additional-2026-10-29-9-12",
    "zhHans": "这局怎么样？",
    "audio": "audio/c5b5ca29b6ee9d84.m4a"
  },
  {
    "id": "additional-2026-10-29-9-13",
    "zhHans": "你觉得怎么样？",
    "audio": "audio/31ee5e552596f020.m4a"
  },
  {
    "id": "additional-2026-10-29-10-1",
    "zhHans": "你有好办法！",
    "audio": "audio/6671dec82631c50f.m4a"
  },
  {
    "id": "additional-2026-10-29-10-2",
    "zhHans": "你有兄弟姐妹吗？",
    "audio": "audio/6818f37160a784a3.m4a"
  },
  {
    "id": "additional-2026-10-29-10-3",
    "zhHans": "你没有朋友了吗？",
    "audio": "audio/fac58e6413d7a758.m4a"
  },
  {
    "id": "additional-2026-10-29-10-4",
    "zhHans": "我没有办法了！",
    "audio": "audio/f1ecbd01370276a7.m4a"
  },
  {
    "id": "additional-2026-10-29-10-5",
    "zhHans": "你有没有秘密？",
    "audio": "audio/3979a5c5a632b930.m4a"
  },
  {
    "id": "additional-2026-10-29-10-6",
    "zhHans": "你有没有棋盘？",
    "audio": "audio/007096ad5d7bd839.m4a"
  },
  {
    "id": "additional-2026-10-29-10-7",
    "zhHans": "你有没有办法？",
    "audio": "audio/0f91aa6725f97baa.m4a"
  },
  {
    "id": "additional-2026-10-29-10-8",
    "zhHans": "你有计划没有？",
    "audio": "audio/6caeb43b5eb54f34.m4a"
  },
  {
    "id": "additional-2026-10-29-11-1",
    "zhHans": "这一步真好！",
    "audio": "audio/535aab76638b3cac.m4a"
  },
  {
    "id": "additional-2026-10-29-11-2",
    "zhHans": "再来一局！",
    "audio": "audio/9b7bb5b09a500c81.m4a"
  },
  {
    "id": "additional-2026-10-29-11-3",
    "zhHans": "我带了一本书。",
    "audio": "audio/275a51b45f209d54.m4a"
  },
  {
    "id": "additional-2026-10-29-11-4",
    "zhHans": "我给你一张照片。",
    "audio": "audio/f62e11bb084baa60.m4a"
  },
  {
    "id": "additional-2026-10-29-11-5",
    "zhHans": "我要一把椅子。",
    "audio": "audio/69816f0c678e3b20.m4a"
  },
  {
    "id": "additional-2026-10-29-11-6",
    "zhHans": "我想吃一条鱼。",
    "audio": "audio/097bfd97ff278d1e.m4a"
  },
  {
    "id": "additional-2026-10-29-11-7",
    "zhHans": "给我一枝笔。",
    "audio": "audio/2838ddb3414a2238.m4a"
  },
  {
    "id": "additional-2026-10-29-11-8",
    "zhHans": "我想吃一块蛋糕。",
    "audio": "audio/e50d552473d0b89a.m4a"
  },
  {
    "id": "additional-2026-10-29-11-9",
    "zhHans": "我坐那辆车回家。",
    "audio": "audio/92a2bc94a691f918.m4a"
  },
  {
    "id": "additional-2026-10-29-11-10",
    "zhHans": "我的两只眼睛都哭红了！",
    "audio": "audio/57b5627b8bf9e5f7.m4a"
  },
  {
    "id": "additional-2026-10-29-11-11",
    "zhHans": "我想买一双新鞋。",
    "audio": "audio/26ebfeb861dfd2a7.m4a"
  },
  {
    "id": "additional-2026-10-29-11-12",
    "zhHans": "我穿了一件新衣服。",
    "audio": "audio/0f5aff9dda110319.m4a"
  },
  {
    "id": "additional-2026-10-29-11-13",
    "zhHans": "我写了一封信。",
    "audio": "audio/96c1486b92bd372b.m4a"
  },
  {
    "id": "additional-2026-10-29-11-14",
    "zhHans": "我坐飞机来的。",
    "audio": "audio/8bd6953381da5f16.m4a"
  },
  {
    "id": "additional-2026-10-29-11-15",
    "zhHans": "我看见一架飞机！",
    "audio": "audio/6ad582a3473048cd.m4a"
  },
  {
    "id": "additional-2026-10-29-11-16",
    "zhHans": "我想吃一碗面条。",
    "audio": "audio/b64f68b06995f43a.m4a"
  },
  {
    "id": "additional-2026-10-29-11-17",
    "zhHans": "喝一杯水吧！",
    "audio": "audio/ce531d146729f374.m4a"
  },
  {
    "id": "additional-2026-10-29-12-1",
    "zhHans": "这里有一个陷阱！",
    "audio": "audio/e7d545894cd0cb3e.m4a"
  },
  {
    "id": "additional-2026-10-29-12-2",
    "zhHans": "桌上有一个棋盘。",
    "audio": "audio/c7e2b715803e524b.m4a"
  },
  {
    "id": "additional-2026-10-29-12-3",
    "zhHans": "前面有敌人！",
    "audio": "audio/e3a87a702983f534.m4a"
  },
  {
    "id": "additional-2026-10-29-12-4",
    "zhHans": "这里没有人帮我！",
    "audio": "audio/418c24e34b4cf999.m4a"
  },
  {
    "id": "additional-2026-10-29-12-5",
    "zhHans": "你身边没有人了。",
    "audio": "audio/b204e58a7194bedf.m4a"
  },
  {
    "id": "additional-2026-10-29-12-6",
    "zhHans": "这里有陷阱吗？",
    "audio": "audio/6355af5ffa8dee2d.m4a"
  },
  {
    "id": "additional-2026-10-29-12-7",
    "zhHans": "桌上有水吗？",
    "audio": "audio/7b724ab83bb7ba67.m4a"
  },
  {
    "id": "additional-2026-10-29-13-1",
    "zhHans": "国王在哪里？",
    "audio": "audio/540563c0549d24e0.m4a"
  },
  {
    "id": "additional-2026-10-29-13-2",
    "zhHans": "王后不在这里了！",
    "audio": "audio/9b198fc8245a2eec.m4a"
  },
  {
    "id": "additional-2026-10-29-13-3",
    "zhHans": "敌人在后面！",
    "audio": "audio/45c76c5b3d5b3e6f.m4a"
  },
  {
    "id": "additional-2026-10-29-13-4",
    "zhHans": "我在家。",
    "audio": "audio/457dfb212537a2df.m4a"
  },
  {
    "id": "additional-2026-10-29-13-5",
    "zhHans": "你的朋友不在这儿。",
    "audio": "audio/7c2a7c4f777eaec4.m4a"
  },
  {
    "id": "additional-2026-10-29-13-6",
    "zhHans": "我的朋友都不在了。",
    "audio": "audio/ce74e30855973649.m4a"
  },
  {
    "id": "additional-2026-10-29-14-1",
    "zhHans": "看后面！",
    "audio": "audio/a5fd6720f75ae907.m4a"
  },
  {
    "id": "additional-2026-10-29-14-2",
    "zhHans": "看前面！",
    "audio": "audio/2bbffd7631a159aa.m4a"
  },
  {
    "id": "additional-2026-10-29-14-3",
    "zhHans": "看左边！",
    "audio": "audio/aeb5430425b6f5d4.m4a"
  },
  {
    "id": "additional-2026-10-29-14-4",
    "zhHans": "看右边！",
    "audio": "audio/62c57cc2f5b07b83.m4a"
  },
  {
    "id": "additional-2026-10-29-14-5",
    "zhHans": "他在我旁边！",
    "audio": "audio/29667a691208268c.m4a"
  },
  {
    "id": "additional-2026-10-29-14-6",
    "zhHans": "危险在上面！",
    "audio": "audio/8f6258516f173c65.m4a"
  },
  {
    "id": "additional-2026-10-29-14-7",
    "zhHans": "下面也有敌人！",
    "audio": "audio/4162f5f4d77efa29.m4a"
  },
  {
    "id": "additional-2026-10-29-14-8",
    "zhHans": "我的兵在哪里？",
    "audio": "audio/7e47adb0e56d457a.m4a"
  },
  {
    "id": "additional-2026-10-29-14-9",
    "zhHans": "棋盘上有什么？",
    "audio": "audio/8675de1abe2c5caa.m4a"
  },
  {
    "id": "additional-2026-10-29-14-10",
    "zhHans": "城堡里只有你。",
    "audio": "audio/692c8232b3c6a1e5.m4a"
  },
  {
    "id": "additional-2026-10-29-14-11",
    "zhHans": "房间里只有我。",
    "audio": "audio/5aae6114910d8199.m4a"
  },
  {
    "id": "additional-2026-10-29-14-12",
    "zhHans": "门外有人！",
    "audio": "audio/cae3ae965c97fe46.m4a"
  },
  {
    "id": "additional-2026-10-29-14-13",
    "zhHans": "敌人在门口！",
    "audio": "audio/7bffc19ea21196ac.m4a"
  },
  {
    "id": "additional-2026-10-29-14-14",
    "zhHans": "国王在城堡里。",
    "audio": "audio/4a7ac8794ca51ef6.m4a"
  },
  {
    "id": "additional-2026-10-29-15-1",
    "zhHans": "别来这儿！",
    "audio": "audio/ad72460447215dbb.m4a"
  },
  {
    "id": "additional-2026-10-29-15-2",
    "zhHans": "快来这儿！",
    "audio": "audio/686be0f2e154b49b.m4a"
  },
  {
    "id": "additional-2026-10-29-15-3",
    "zhHans": "别去那儿！",
    "audio": "audio/c225166b66c2657e.m4a"
  },
  {
    "id": "additional-2026-10-29-15-4",
    "zhHans": "你怎么到那儿去了？",
    "audio": "audio/de28eff0b39e5886.m4a"
  },
  {
    "id": "additional-2026-10-29-15-5",
    "zhHans": "这里安全吗？",
    "audio": "audio/40315fab084bf5f1.m4a"
  },
  {
    "id": "additional-2026-10-29-15-6",
    "zhHans": "这里很危险！",
    "audio": "audio/dc7a725aabbe5f96.m4a"
  },
  {
    "id": "additional-2026-10-29-15-7",
    "zhHans": "那里有什么？",
    "audio": "audio/b9ac0bac7733c1f0.m4a"
  },
  {
    "id": "additional-2026-10-29-15-8",
    "zhHans": "那里不安全！",
    "audio": "audio/3f0d50b59f77f941.m4a"
  },
  {
    "id": "additional-2026-10-29-15-9",
    "zhHans": "你要去哪里？",
    "audio": "audio/6be1ffca8ba569f3.m4a"
  },
  {
    "id": "additional-2026-10-29-15-10",
    "zhHans": "我该去哪里？",
    "audio": "audio/a690ec46aed5c4a3.m4a"
  },
  {
    "id": "additional-2026-10-29-15-11",
    "zhHans": "你那儿有棋盘吗？",
    "audio": "audio/a4c724f0ab28dde0.m4a"
  },
  {
    "id": "additional-2026-10-29-15-12",
    "zhHans": "我这儿有水。",
    "audio": "audio/02bc34e449730b12.m4a"
  },
  {
    "id": "additional-2026-10-29-15-13",
    "zhHans": "你朋友那儿还有人吗？",
    "audio": "audio/0fc8f7dcb8d1bbab.m4a"
  },
  {
    "id": "additional-2026-10-29-16-1",
    "zhHans": "你非常聪明！",
    "audio": "audio/6f569c9b997d124d.m4a"
  },
  {
    "id": "additional-2026-10-29-16-2",
    "zhHans": "你非常厉害！",
    "audio": "audio/ef98c854dbad7d71.m4a"
  },
  {
    "id": "additional-2026-10-29-16-3",
    "zhHans": "今天比较热。",
    "audio": "audio/435ef2c6c9502813.m4a"
  },
  {
    "id": "additional-2026-10-29-16-4",
    "zhHans": "这局比较难。",
    "audio": "audio/d92f34e59a4a8992.m4a"
  },
  {
    "id": "additional-2026-10-29-16-5",
    "zhHans": "我有点儿紧张。",
    "audio": "audio/25c924981b74e69f.m4a"
  },
  {
    "id": "additional-2026-10-29-16-6",
    "zhHans": "我有点儿害怕。",
    "audio": "audio/25acd6330122abd3.m4a"
  },
  {
    "id": "additional-2026-10-29-16-7",
    "zhHans": "我有点儿累了。",
    "audio": "audio/40516cf3f2353c16.m4a"
  },
  {
    "id": "additional-2026-10-29-17-1",
    "zhHans": "我不开心。",
    "audio": "audio/324079c3a47b48bf.m4a"
  },
  {
    "id": "additional-2026-10-29-17-2",
    "zhHans": "我不害怕！",
    "audio": "audio/32df2cb04d32af6c.m4a"
  },
  {
    "id": "additional-2026-10-29-17-3",
    "zhHans": "我不很高兴。",
    "audio": "audio/a917c69b166cfe13.m4a"
  },
  {
    "id": "additional-2026-10-29-17-4",
    "zhHans": "我很不高兴！",
    "audio": "audio/5e6796b996000c1b.m4a"
  },
  {
    "id": "additional-2026-10-29-17-5",
    "zhHans": "今天不很冷。",
    "audio": "audio/8d0b0eef953f6186.m4a"
  },
  {
    "id": "additional-2026-10-29-17-6",
    "zhHans": "你太快了！",
    "audio": "audio/5aa6ec94879eee3f.m4a"
  },
  {
    "id": "additional-2026-10-29-17-7",
    "zhHans": "这太危险了！",
    "audio": "audio/dbe3d930a6b8a912.m4a"
  },
  {
    "id": "additional-2026-10-29-18-1",
    "zhHans": "你忙不忙？",
    "audio": "audio/9eb23abbe4765f14.m4a"
  },
  {
    "id": "additional-2026-10-29-18-2",
    "zhHans": "你紧张不紧张？",
    "audio": "audio/67688133b061aba2.m4a"
  },
  {
    "id": "additional-2026-10-29-18-3",
    "zhHans": "你累不累？",
    "audio": "audio/d04a9a6f0a069fdf.m4a"
  },
  {
    "id": "additional-2026-10-29-18-4",
    "zhHans": "这一步难不难？",
    "audio": "audio/bc93ff68d868834a.m4a"
  },
  {
    "id": "additional-2026-10-29-18-5",
    "zhHans": "这局有多难？",
    "audio": "audio/5af374ab8d5c5ce3.m4a"
  },
  {
    "id": "additional-2026-10-29-18-6",
    "zhHans": "你觉得这局怎么样？",
    "audio": "audio/1a5686ee9f456a91.m4a"
  },
  {
    "id": "additional-2026-10-29-19-1",
    "zhHans": "这是一个很好的办法。",
    "audio": "audio/56e08902e88e88d6.m4a"
  },
  {
    "id": "additional-2026-10-29-19-2",
    "zhHans": "你是一个很强的对手。",
    "audio": "audio/9c72e1b511ea3775.m4a"
  },
  {
    "id": "additional-2026-10-29-19-3",
    "zhHans": "今天是非常重要的一天。",
    "audio": "audio/a3b29903106e9102.m4a"
  },
  {
    "id": "additional-2026-10-29-19-4",
    "zhHans": "这是一个非常好的主意！",
    "audio": "audio/75586ead0b6e1637.m4a"
  },
  {
    "id": "additional-2026-10-29-19-5",
    "zhHans": "这是一场挺有意思的比赛。",
    "audio": "audio/3fcb6cb56117f8a0.m4a"
  },
  {
    "id": "additional-2026-10-29-20-1",
    "zhHans": "我想喝热热的茶。",
    "audio": "audio/27abf2e5bf7d5922.m4a"
  },
  {
    "id": "additional-2026-10-29-20-2",
    "zhHans": "我的小小的梦想破灭了。",
    "audio": "audio/b7973c7815764403.m4a"
  },
  {
    "id": "additional-2026-10-29-21-1",
    "zhHans": "这是你想的办法吗？",
    "audio": "audio/bfe6feaeae2a2a6c.m4a"
  },
  {
    "id": "additional-2026-10-29-21-2",
    "zhHans": "这是我写的书。",
    "audio": "audio/32b6dca41b912c27.m4a"
  },
  {
    "id": "additional-2026-10-29-22-1",
    "zhHans": "我有很多问题！",
    "audio": "audio/23fc9e7fa837dd17.m4a"
  },
  {
    "id": "additional-2026-10-29-22-2",
    "zhHans": "你有不少好办法！",
    "audio": "audio/ebd97223b1f165df.m4a"
  },
  {
    "id": "additional-2026-10-29-22-3",
    "zhHans": "今天学了很多东西。",
    "audio": "audio/fa157e7f586ed0af.m4a"
  },
  {
    "id": "additional-2026-10-29-22-4",
    "zhHans": "我还有很多要学的东西。",
    "audio": "audio/ce93a45f7a066f26.m4a"
  },
  {
    "id": "additional-2026-10-29-23-1",
    "zhHans": "这局不很难。",
    "audio": "audio/83abc49d264e8204.m4a"
  },
  {
    "id": "translated-1-1",
    "zhHans": "他被关进监狱了。",
    "audio": "audio/98c4cbcf27109302.m4a"
  },
  {
    "id": "translated-1-2",
    "zhHans": "我在打扫房间。",
    "audio": "audio/36798f426cac8dca.m4a"
  },
  {
    "id": "translated-1-3",
    "zhHans": "我在收拾桌上的东西。",
    "audio": "audio/49d1ea6b02eef999.m4a"
  },
  {
    "id": "translated-2-1",
    "zhHans": "可惜，兵消失了。",
    "audio": "audio/e9cb716af71d0ad9.m4a"
  },
  {
    "id": "translated-2-2",
    "zhHans": "那可是我喜欢的兵！",
    "audio": "audio/04669864b0f27e07.m4a"
  },
  {
    "id": "translated-2-3",
    "zhHans": "他们只是我的手和脚。",
    "audio": "audio/9906be68e8af3321.m4a"
  },
  {
    "id": "translated-3-1",
    "zhHans": "再见了。",
    "audio": "audio/6cb187a2f4330001.m4a"
  },
  {
    "id": "translated-4-1",
    "zhHans": "我那匹可爱的马啊！",
    "audio": "audio/2ffd1b5525f97d82.m4a"
  },
  {
    "id": "translated-4-2",
    "zhHans": "我刚买了它！",
    "audio": "audio/9963ecb1d5c628db.m4a"
  },
  {
    "id": "translated-5-1",
    "zhHans": "呼，热起来了！",
    "audio": "audio/45acf0f224981369.m4a"
  },
  {
    "id": "translated-6-1",
    "zhHans": "再见了。",
    "audio": "audio/6cb187a2f4330001.m4a"
  },
  {
    "id": "translated-7-1",
    "zhHans": "你累了吗？",
    "audio": "audio/8ed7bc08e1941b84.m4a"
  },
  {
    "id": "translated-7-2",
    "zhHans": "再见了。",
    "audio": "audio/6cb187a2f4330001.m4a"
  },
  {
    "id": "translated-7-3",
    "zhHans": "我攻下了移动的城堡！",
    "audio": "audio/55d4b0f91a01c889.m4a"
  },
  {
    "id": "translated-7-4",
    "zhHans": "你的车？我给你洗！",
    "audio": "audio/cb86798c17ad672e.m4a"
  },
  {
    "id": "translated-8-1",
    "zhHans": "喝杯咖啡，冷静一下。",
    "audio": "audio/be207260dec43b36.m4a"
  },
  {
    "id": "translated-8-2",
    "zhHans": "喝点水，冷静一下。",
    "audio": "audio/78631fa1464762a2.m4a"
  },
  {
    "id": "translated-9-1",
    "zhHans": "别生气啊！",
    "audio": "audio/f6ff1f1985d306cf.m4a"
  },
  {
    "id": "translated-9-2",
    "zhHans": "再见了。",
    "audio": "audio/6cb187a2f4330001.m4a"
  },
  {
    "id": "translated-9-3",
    "zhHans": "怎么了？脸都白了！",
    "audio": "audio/300a6fe38128932f.m4a"
  },
  {
    "id": "translated-9-4",
    "zhHans": "我胸口很疼。",
    "audio": "audio/d7d982c5b13c441b.m4a"
  },
  {
    "id": "translated-9-5",
    "zhHans": "王后……死了……",
    "audio": "audio/67159b4601910ab5.m4a"
  },
  {
    "id": "translated-10-1",
    "zhHans": "我想回家了。",
    "audio": "audio/a3760a533d846dba.m4a"
  },
  {
    "id": "translated-10-2",
    "zhHans": "我快哭了。",
    "audio": "audio/6b98e1bf981ab9ef.m4a"
  },
  {
    "id": "translated-10-3",
    "zhHans": "啊，头好疼。",
    "audio": "audio/b1a5b82de8794e53.m4a"
  },
  {
    "id": "translated-10-4",
    "zhHans": "王后……死了……",
    "audio": "audio/67159b4601910ab5.m4a"
  },
  {
    "id": "translated-10-5",
    "zhHans": "你有一颗冰冷的心！",
    "audio": "audio/c51020a975894a02.m4a"
  },
  {
    "id": "translated-11-1",
    "zhHans": "这局真好玩！",
    "audio": "audio/59e027370f6444ac.m4a"
  },
  {
    "id": "translated-12-1",
    "zhHans": "你是白方。",
    "audio": "audio/df28200cbcd3385e.m4a"
  },
  {
    "id": "translated-12-2",
    "zhHans": "我是黑方。",
    "audio": "audio/d3f1516fa310e31e.m4a"
  },
  {
    "id": "translated-13-1",
    "zhHans": "你是黑方。",
    "audio": "audio/00d00cc1c2026a19.m4a"
  },
  {
    "id": "translated-13-2",
    "zhHans": "我是白方。",
    "audio": "audio/787754dfc1dd86b8.m4a"
  },
  {
    "id": "translated-14-1",
    "zhHans": "听说国际象棋起源于印度。",
    "audio": "audio/65eb43017e575309.m4a"
  },
  {
    "id": "translated-14-2",
    "zhHans": "我们下棋吧！",
    "audio": "audio/725665c001c728c1.m4a"
  },
  {
    "id": "translated-14-3",
    "zhHans": "你是白方。",
    "audio": "audio/df28200cbcd3385e.m4a"
  },
  {
    "id": "translated-14-4",
    "zhHans": "你是黑方。",
    "audio": "audio/00d00cc1c2026a19.m4a"
  },
  {
    "id": "translated-14-5",
    "zhHans": "我是白方。",
    "audio": "audio/787754dfc1dd86b8.m4a"
  },
  {
    "id": "translated-14-6",
    "zhHans": "我是黑方。",
    "audio": "audio/d3f1516fa310e31e.m4a"
  },
  {
    "id": "translated-14-7",
    "zhHans": "你怕输吗？",
    "audio": "audio/301d719a59a2fea1.m4a"
  },
  {
    "id": "translated-14-8",
    "zhHans": "我一定会赢！",
    "audio": "audio/155fccf3ef7a41e5.m4a"
  },
  {
    "id": "translated-14-9",
    "zhHans": "欢迎来到国际象棋学校！",
    "audio": "audio/febfb55f1b83fe11.m4a"
  },
  {
    "id": "translated-14-10",
    "zhHans": "我们开始吧！",
    "audio": "audio/7db837fc12ef7da4.m4a"
  },
  {
    "id": "translated-14-11",
    "zhHans": "我是老师，你是学生。",
    "audio": "audio/bb3a3f96d5106588.m4a"
  },
  {
    "id": "translated-15-1",
    "zhHans": "我去找国王了！",
    "audio": "audio/d5751d90c791f853.m4a"
  },
  {
    "id": "translated-15-2",
    "zhHans": "你逃不掉了！",
    "audio": "audio/c85046b323c3d86d.m4a"
  },
  {
    "id": "translated-15-3",
    "zhHans": "小心背后！",
    "audio": "audio/6605a6aee0aaa0dd.m4a"
  },
  {
    "id": "translated-16-1",
    "zhHans": "陛下要过来了！让路！",
    "audio": "audio/a58ad5e4db43178f.m4a"
  },
  {
    "id": "translated-16-2",
    "zhHans": "别过来！",
    "audio": "audio/a3f3aa639e4c5bdb.m4a"
  },
  {
    "id": "translated-16-3",
    "zhHans": "这是叛乱！",
    "audio": "audio/c48596319281fb04.m4a"
  },
  {
    "id": "translated-17-1",
    "zhHans": "赢了，开心吗？太好了！",
    "audio": "audio/bee271e268dc5247.m4a"
  },
  {
    "id": "translated-17-2",
    "zhHans": "国破山河在。",
    "audio": "audio/9d79ace079cd3e18.m4a"
  },
  {
    "id": "translated-17-3",
    "zhHans": "我讨厌输。",
    "audio": "audio/acf504c3a0b90716.m4a"
  },
  {
    "id": "translated-17-4",
    "zhHans": "你比我强！",
    "audio": "audio/46e167cbda570e27.m4a"
  },
  {
    "id": "translated-17-5",
    "zhHans": "别告诉我妈妈！",
    "audio": "audio/5287ececace479d5.m4a"
  },
  {
    "id": "translated-17-6",
    "zhHans": "别告诉我爸爸！",
    "audio": "audio/b16d56e32ccc853c.m4a"
  },
  {
    "id": "translated-17-7",
    "zhHans": "明天我会赢！",
    "audio": "audio/0a33f67f997922a3.m4a"
  },
  {
    "id": "translated-18-1",
    "zhHans": "借你一本棋书？",
    "audio": "audio/f5ba99caf07e52b1.m4a"
  },
  {
    "id": "translated-18-2",
    "zhHans": "比赛结束了。",
    "audio": "audio/713e36eb4c16cb15.m4a"
  },
  {
    "id": "translated-18-3",
    "zhHans": "弱一点也没关系。",
    "audio": "audio/5a52f3ba8a9740ba.m4a"
  },
  {
    "id": "translated-18-4",
    "zhHans": "不甘心吗？",
    "audio": "audio/627f6dd4230aaa38.m4a"
  },
  {
    "id": "translated-18-5",
    "zhHans": "真该录个视频！",
    "audio": "audio/dc399ebf7f1b49b0.m4a"
  },
  {
    "id": "translated-18-6",
    "zhHans": "明天再下吧！",
    "audio": "audio/ef4bec01ea798704.m4a"
  },
  {
    "id": "translated-19-1",
    "zhHans": "你看到了吗？",
    "audio": "audio/6d4332d9955fce54.m4a"
  },
  {
    "id": "translated-19-2",
    "zhHans": "王侯将相，宁有种乎！",
    "audio": "audio/8d272c78cd577e7d.m4a"
  },
  {
    "id": "translated-20-1",
    "zhHans": "〇〇出现了！",
    "audio": "audio/97f9a16a5c3356be.m4a"
  },
  {
    "id": "translated-20-2",
    "zhHans": "王后回来了！",
    "audio": "audio/eedca40ad3f1870b.m4a"
  },
  {
    "id": "translated-21-1",
    "zhHans": "我不会放弃！",
    "audio": "audio/7b4c9687c65dc4cb.m4a"
  },
  {
    "id": "translated-21-2",
    "zhHans": "救命！",
    "audio": "audio/cc2057edc8c2ff3d.m4a"
  },
  {
    "id": "translated-21-3",
    "zhHans": "借我手机！我要打电话求救！",
    "audio": "audio/40837e99e08bbb25.m4a"
  },
  {
    "id": "translated-22-1",
    "zhHans": "只剩你一个了。",
    "audio": "audio/0ab3fd08eb10311b.m4a"
  },
  {
    "id": "translated-22-2",
    "zhHans": "寂寞吗？",
    "audio": "audio/973ce0fcbd529cbd.m4a"
  },
  {
    "id": "translated-22-3",
    "zhHans": "陛下，您寂寞吗？",
    "audio": "audio/95c8fa5b63205e90.m4a"
  },
  {
    "id": "translated-23-1",
    "zhHans": "早上好！",
    "audio": "audio/0962b3a92ebe1cde.m4a"
  },
  {
    "id": "translated-23-2",
    "zhHans": "你起得真早！",
    "audio": "audio/4140cb3787b8c0b7.m4a"
  },
  {
    "id": "translated-23-3",
    "zhHans": "外面很亮。",
    "audio": "audio/3e9b3de93ff22290.m4a"
  },
  {
    "id": "translated-24-1",
    "zhHans": "晚上好！",
    "audio": "audio/8dc22ecf0f408c1b.m4a"
  },
  {
    "id": "translated-24-2",
    "zhHans": "现在？你不困吗？",
    "audio": "audio/4e41400aec0dfd85.m4a"
  },
  {
    "id": "translated-24-3",
    "zhHans": "你睡得真晚！",
    "audio": "audio/6bb3fe753280a031.m4a"
  },
  {
    "id": "translated-24-4",
    "zhHans": "外面已经黑了。",
    "audio": "audio/8f489d73a16d4dcb.m4a"
  },
  {
    "id": "translated-24-5",
    "zhHans": "现在几点了？",
    "audio": "audio/65dec52aefdff39d.m4a"
  },
  {
    "id": "translated-25-1",
    "zhHans": "陛下进城堡了！",
    "audio": "audio/a5277f9500d0bbae.m4a"
  },
  {
    "id": "translated-26-1",
    "zhHans": "陛下，请出来！",
    "audio": "audio/63b949f59a94129f.m4a"
  },
  {
    "id": "translated-27-1",
    "zhHans": "又见面了！",
    "audio": "audio/186e037c8ca6784e.m4a"
  },
  {
    "id": "translated-27-2",
    "zhHans": "今天都见你好几次了！",
    "audio": "audio/b20688d5538597a6.m4a"
  },
  {
    "id": "translated-28-1",
    "zhHans": "真快！",
    "audio": "audio/f9cfb8f3077db3e2.m4a"
  },
  {
    "id": "translated-28-2",
    "zhHans": "太快了！",
    "audio": "audio/5361d45135457361.m4a"
  },
  {
    "id": "translated-29-1",
    "zhHans": "形势逆转了！",
    "audio": "audio/518c66df2c1a8320.m4a"
  },
  {
    "id": "translated-30-1",
    "zhHans": "求你了，等一下！",
    "audio": "audio/878f44716d73d98b.m4a"
  },
  {
    "id": "translated-31-1",
    "zhHans": "小时候，爷爷教过我。",
    "audio": "audio/252532d18c6e189a.m4a"
  },
  {
    "id": "translated-31-2",
    "zhHans": "小时候，奶奶教过我。",
    "audio": "audio/323db9b8d1f8d7e0.m4a"
  }
]