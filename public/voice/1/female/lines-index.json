[
  {
    "id": "additional-2026-10-29-1-1",
    "zhHans": "我不喜欢输。",
    "audio": "audio/26e97c07cc0f9ee2.m4a"
  },
  {
    "id": "additional-2026-10-29-1-2",
    "zhHans": "我不走！",
    "audio": "audio/236aa57732bdd6e7.m4a"
  },
  {
    "id": "additional-2026-10-29-1-3",
    "zhHans": "你也喜欢下棋吗？",
    "audio": "audio/57452e7ecf3e5b88.m4a"
  },
  {
    "id": "additional-2026-10-29-1-4",
    "zhHans": "我也来了！",
    "audio": "audio/1444a2d3a3f87de3.m4a"
  },
  {
    "id": "additional-2026-10-29-1-5",
    "zhHans": "我们都准备好了。",
    "audio": "audio/ecbd67bf53b5e92f.m4a"
  },
  {
    "id": "additional-2026-10-29-2-1",
    "zhHans": "咱们开始吧！",
    "audio": "audio/ffdeacc160d7614a.m4a"
  },
  {
    "id": "additional-2026-10-29-2-2",
    "zhHans": "咱们再来一局！",
    "audio": "audio/1ad69fa368524285.m4a"
  },
  {
    "id": "additional-2026-10-29-2-3",
    "zhHans": "咱们明天再玩吧！",
    "audio": "audio/62dcec2811b099d9.m4a"
  },
  {
    "id": "additional-2026-10-29-2-4",
    "zhHans": "你们准备好了吗？",
    "audio": "audio/10c289c0b08968d3.m4a"
  },
  {
    "id": "additional-2026-10-29-2-5",
    "zhHans": "你们真厉害！",
    "audio": "audio/e9a2cfecd9656d3d.m4a"
  },
  {
    "id": "additional-2026-10-29-2-6",
    "zhHans": "你们起得真早！",
    "audio": "audio/2ee7cd39072e177d.m4a"
  },
  {
    "id": "additional-2026-10-29-2-7",
    "zhHans": "大家准备好了吗？",
    "audio": "audio/c6f4568f01126d5f.m4a"
  },
  {
    "id": "additional-2026-10-29-2-8",
    "zhHans": "大家都笑我！",
    "audio": "audio/5e13dc5c5c59ccba.m4a"
  },
  {
    "id": "additional-2026-10-29-3-1",
    "zhHans": "她是我的朋友。",
    "audio": "audio/041edb5d4ced82c1.m4a"
  },
  {
    "id": "additional-2026-10-29-3-2",
    "zhHans": "她跑得真快！",
    "audio": "audio/bd730544e11bedae.m4a"
  },
  {
    "id": "additional-2026-10-29-3-3",
    "zhHans": "她回来了！",
    "audio": "audio/e196aee56983cbf3.m4a"
  },
  {
    "id": "additional-2026-10-29-3-4",
    "zhHans": "她们都走了。",
    "audio": "audio/40e397bd9e0919a3.m4a"
  },
  {
    "id": "additional-2026-10-29-3-5",
    "zhHans": "他们都走了。",
    "audio": "audio/d8b7b8d80e3226a6.m4a"
  },
  {
    "id": "additional-2026-10-29-3-6",
    "zhHans": "他们不在这里。",
    "audio": "audio/762d123d217592d9.m4a"
  },
  {
    "id": "additional-2026-10-29-4-1",
    "zhHans": "它不见了！",
    "audio": "audio/3c0b0cbdc073e0f2.m4a"
  },
  {
    "id": "additional-2026-10-29-4-2",
    "zhHans": "它去哪儿了？",
    "audio": "audio/9b0e8e6a083d8db9.m4a"
  },
  {
    "id": "additional-2026-10-29-4-3",
    "zhHans": "它变了！",
    "audio": "audio/1741eb91d4f74864.m4a"
  },
  {
    "id": "additional-2026-10-29-4-4",
    "zhHans": "它们去哪儿了？",
    "audio": "audio/cb7cd41a68293c3b.m4a"
  },
  {
    "id": "additional-2026-10-29-4-5",
    "zhHans": "我自己来！",
    "audio": "audio/416314261bf6d093.m4a"
  },
  {
    "id": "additional-2026-10-29-4-6",
    "zhHans": "你自己来吗？",
    "audio": "audio/624b2cdcd8f726b0.m4a"
  },
  {
    "id": "additional-2026-10-29-4-7",
    "zhHans": "别告诉别人！",
    "audio": "audio/0d5f6b201a96be34.m4a"
  },
  {
    "id": "additional-2026-10-29-4-8",
    "zhHans": "人家不想输嘛！",
    "audio": "audio/ba77773dd7b5e01f.m4a"
  },
  {
    "id": "additional-2026-10-29-5-1",
    "zhHans": "你不是黑方。",
    "audio": "audio/602fe2477b5b3704.m4a"
  },
  {
    "id": "additional-2026-10-29-5-2",
    "zhHans": "我不是黑方。",
    "audio": "audio/b2bf74393fbffa67.m4a"
  },
  {
    "id": "additional-2026-10-29-5-3",
    "zhHans": "这不是玩笑！",
    "audio": "audio/53f1192bffbfde00.m4a"
  },
  {
    "id": "additional-2026-10-29-5-4",
    "zhHans": "你是学生吗？",
    "audio": "audio/0ff3928bb2f10484.m4a"
  },
  {
    "id": "additional-2026-10-29-5-5",
    "zhHans": "这是你的棋盘吗？",
    "audio": "audio/1687708e383d9646.m4a"
  },
  {
    "id": "additional-2026-10-29-5-6",
    "zhHans": "这是你的计划吗？",
    "audio": "audio/ee896cfeb8ca4c22.m4a"
  },
  {
    "id": "additional-2026-10-29-5-7",
    "zhHans": "我也是学生。",
    "audio": "audio/489f22ef0a15057e.m4a"
  },
  {
    "id": "additional-2026-10-29-5-8",
    "zhHans": "她也是王后！",
    "audio": "audio/abe8b8abc0c9e593.m4a"
  },
  {
    "id": "additional-2026-10-29-5-9",
    "zhHans": "我们都是学生。",
    "audio": "audio/a292906a31db379f.m4a"
  },
  {
    "id": "additional-2026-10-29-5-10",
    "zhHans": "我也不是每次都赢。",
    "audio": "audio/f6ad35a38fd69f41.m4a"
  },
  {
    "id": "additional-2026-10-29-6-1",
    "zhHans": "这个很好！",
    "audio": "audio/5c2bbe19ad2b0a9e.m4a"
  },
  {
    "id": "additional-2026-10-29-6-2",
    "zhHans": "那个更好！",
    "audio": "audio/232a877284e02775.m4a"
  },
  {
    "id": "additional-2026-10-29-6-3",
    "zhHans": "这个游戏真有趣！",
    "audio": "audio/2ffa97697cb7c75f.m4a"
  },
  {
    "id": "additional-2026-10-29-6-4",
    "zhHans": "那个办法真好！",
    "audio": "audio/30dd64305c457355.m4a"
  },
  {
    "id": "additional-2026-10-29-6-5",
    "zhHans": "你喜欢哪个？",
    "audio": "audio/19a7d2c9ada6bd8b.m4a"
  },
  {
    "id": "additional-2026-10-29-6-6",
    "zhHans": "你要哪个？",
    "audio": "audio/eb323fd51edd8c68.m4a"
  },
  {
    "id": "additional-2026-10-29-6-7",
    "zhHans": "哪匹马不见了？",
    "audio": "audio/3face69db4464560.m4a"
  },
  {
    "id": "additional-2026-10-29-6-8",
    "zhHans": "这些是谁的？",
    "audio": "audio/566e14f2c2f520bd.m4a"
  },
  {
    "id": "additional-2026-10-29-6-9",
    "zhHans": "那些都是我的！",
    "audio": "audio/6723cbeb66657885.m4a"
  },
  {
    "id": "additional-2026-10-29-6-10",
    "zhHans": "这些是什么？",
    "audio": "audio/dffb76687a824187.m4a"
  },
  {
    "id": "additional-2026-10-29-6-11",
    "zhHans": "哪些是你的？",
    "audio": "audio/26ada0c5af1824fa.m4a"
  },
  {
    "id": "additional-2026-10-29-6-12",
    "zhHans": "那些兵都去哪儿了？",
    "audio": "audio/a853d875a7160c0d.m4a"
  },
  {
    "id": "additional-2026-10-29-7-1",
    "zhHans": "这是中国的游戏吗？",
    "audio": "audio/1f339a0a5d05acea.m4a"
  },
  {
    "id": "additional-2026-10-29-7-2",
    "zhHans": "这是我的，你的是那个。",
    "audio": "audio/d27c07aa6a8dd742.m4a"
  },
  {
    "id": "additional-2026-10-29-7-3",
    "zhHans": "白色的是你的。",
    "audio": "audio/e057c1fd95c8fb72.m4a"
  },
  {
    "id": "additional-2026-10-29-7-4",
    "zhHans": "黑色的是你的。",
    "audio": "audio/5233a3eaf1ed52b2.m4a"
  },
  {
    "id": "additional-2026-10-29-7-5",
    "zhHans": "我的老师喜欢下棋。",
    "audio": "audio/009a7483b7603162.m4a"
  },
  {
    "id": "additional-2026-10-29-7-6",
    "zhHans": "我老师会生气的！",
    "audio": "audio/5cb6f8dc909026bf.m4a"
  },
  {
    "id": "additional-2026-10-29-7-7",
    "zhHans": "我们学校也有棋社。",
    "audio": "audio/93c4dbba37b3547a.m4a"
  },
  {
    "id": "additional-2026-10-29-7-8",
    "zhHans": "我家有棋盘。",
    "audio": "audio/e07a9e6740ed8193.m4a"
  },
  {
    "id": "additional-2026-10-29-7-9",
    "zhHans": "这是一个重要的问题。",
    "audio": "audio/85cf562453d66ef2.m4a"
  },
  {
    "id": "additional-2026-10-29-7-10",
    "zhHans": "这是一个好办法！",
    "audio": "audio/13e63a88e0ef7f00.m4a"
  },
  {
    "id": "additional-2026-10-29-8-1",
    "zhHans": "你玩不玩？",
    "audio": "audio/9db7c7e29e392f54.m4a"
  },
  {
    "id": "additional-2026-10-29-8-2",
    "zhHans": "你来不来？",
    "audio": "audio/85e5d041c684a86e.m4a"
  },
  {
    "id": "additional-2026-10-29-8-3",
    "zhHans": "你走不走？",
    "audio": "audio/d33eb402ff6991eb.m4a"
  },
  {
    "id": "additional-2026-10-29-8-4",
    "zhHans": "你是不是学生？",
    "audio": "audio/1e8c34139e13220f.m4a"
  },
  {
    "id": "additional-2026-10-29-8-5",
    "zhHans": "这是不是将军？",
    "audio": "audio/f38aada83bcacfca.m4a"
  },
  {
    "id": "additional-2026-10-29-8-6",
    "zhHans": "这是不是陷阱？",
    "audio": "audio/787542b5c5635f84.m4a"
  },
  {
    "id": "additional-2026-10-29-8-7",
    "zhHans": "你想不想再玩？",
    "audio": "audio/0e0c6d127e3cbdef.m4a"
  },
  {
    "id": "additional-2026-10-29-8-8",
    "zhHans": "你下不下棋？",
    "audio": "audio/28deb237572f282b.m4a"
  },
  {
    "id": "additional-2026-10-29-8-9",
    "zhHans": "你喝不喝水？",
    "audio": "audio/9c28dd8188f00529.m4a"
  },
  {
    "id": "additional-2026-10-29-8-10",
    "zhHans": "你下棋不下？",
    "audio": "audio/f07ff589cb2beeb3.m4a"
  },
  {
    "id": "additional-2026-10-29-8-11",
    "zhHans": "你喝水不喝？",
    "audio": "audio/4abc0037cacad2ff.m4a"
  },
  {
    "id": "additional-2026-10-29-9-1",
    "zhHans": "这是什么？",
    "audio": "audio/a9e51f28b7ac3b67.m4a"
  },
  {
    "id": "additional-2026-10-29-9-2",
    "zhHans": "你想干什么？",
    "audio": "audio/e21c7e9f1120e976.m4a"
  },
  {
    "id": "additional-2026-10-29-9-3",
    "zhHans": "谁干的？",
    "audio": "audio/d4403086b396659e.m4a"
  },
  {
    "id": "additional-2026-10-29-9-4",
    "zhHans": "谁教你的？",
    "audio": "audio/86b363736f2aad42.m4a"
  },
  {
    "id": "additional-2026-10-29-9-5",
    "zhHans": "你的朋友在哪儿？",
    "audio": "audio/28eb7782daf21219.m4a"
  },
  {
    "id": "additional-2026-10-29-9-6",
    "zhHans": "我的朋友去哪儿了？",
    "audio": "audio/e10c3f07f8eb6628.m4a"
  },
  {
    "id": "additional-2026-10-29-9-7",
    "zhHans": "你什么时候回家？",
    "audio": "audio/79dd3a206eedf49b.m4a"
  },
  {
    "id": "additional-2026-10-29-9-8",
    "zhHans": "你什么时候学的棋？",
    "audio": "audio/4e9f95d4d23baca6.m4a"
  },
  {
    "id": "additional-2026-10-29-9-9",
    "zhHans": "为什么是她？",
    "audio": "audio/4e9dffc626230e94.m4a"
  },
  {
    "id": "additional-2026-10-29-9-10",
    "zhHans": "为什么走这一步？",
    "audio": "audio/7dc1f4fcf6b7403f.m4a"
  },
  {
    "id": "additional-2026-10-29-9-11",
    "zhHans": "今天怎么样？",
    "audio": "audio/6da46542c2abb1c4.m4a"
  },
  {
    "id": "additional-2026-10-29-9-12",
    "zhHans": "这局怎么样？",
    "audio": "audio/28dcd0b68f40a9af.m4a"
  },
  {
    "id": "additional-2026-10-29-9-13",
    "zhHans": "你觉得怎么样？",
    "audio": "audio/e8fb167b4e07fd60.m4a"
  },
  {
    "id": "additional-2026-10-29-10-1",
    "zhHans": "你有好办法！",
    "audio": "audio/4a1e6861dc09bd3b.m4a"
  },
  {
    "id": "additional-2026-10-29-10-2",
    "zhHans": "你有兄弟姐妹吗？",
    "audio": "audio/02278993d296bc20.m4a"
  },
  {
    "id": "additional-2026-10-29-10-3",
    "zhHans": "你没有朋友了吗？",
    "audio": "audio/065818710f4b4e13.m4a"
  },
  {
    "id": "additional-2026-10-29-10-4",
    "zhHans": "我没有办法了！",
    "audio": "audio/e0bea752b06f2e96.m4a"
  },
  {
    "id": "additional-2026-10-29-10-5",
    "zhHans": "你有没有秘密？",
    "audio": "audio/e70352dc53923a12.m4a"
  },
  {
    "id": "additional-2026-10-29-10-6",
    "zhHans": "你有没有棋盘？",
    "audio": "audio/d88af8a07ce01e05.m4a"
  },
  {
    "id": "additional-2026-10-29-10-7",
    "zhHans": "你有没有办法？",
    "audio": "audio/036a3d9e82f40393.m4a"
  },
  {
    "id": "additional-2026-10-29-10-8",
    "zhHans": "你有计划没有？",
    "audio": "audio/de834852eb69b563.m4a"
  },
  {
    "id": "additional-2026-10-29-11-1",
    "zhHans": "这一步真好！",
    "audio": "audio/3d243add0ab3bd32.m4a"
  },
  {
    "id": "additional-2026-10-29-11-2",
    "zhHans": "再来一局！",
    "audio": "audio/3aa4e43552f601ed.m4a"
  },
  {
    "id": "additional-2026-10-29-11-3",
    "zhHans": "我带了一本书。",
    "audio": "audio/2fe2a5d515a00712.m4a"
  },
  {
    "id": "additional-2026-10-29-11-4",
    "zhHans": "我给你一张照片。",
    "audio": "audio/ba6a3c4a360d2bf2.m4a"
  },
  {
    "id": "additional-2026-10-29-11-5",
    "zhHans": "我要一把椅子。",
    "audio": "audio/3788602eb54844e8.m4a"
  },
  {
    "id": "additional-2026-10-29-11-6",
    "zhHans": "我想吃一条鱼。",
    "audio": "audio/f9fc626848a255e5.m4a"
  },
  {
    "id": "additional-2026-10-29-11-7",
    "zhHans": "给我一枝笔。",
    "audio": "audio/342a5daf58c68e64.m4a"
  },
  {
    "id": "additional-2026-10-29-11-8",
    "zhHans": "我想吃一块蛋糕。",
    "audio": "audio/d9d31f76ae184c94.m4a"
  },
  {
    "id": "additional-2026-10-29-11-9",
    "zhHans": "我坐那辆车回家。",
    "audio": "audio/3c7ba2cf247af5b0.m4a"
  },
  {
    "id": "additional-2026-10-29-11-10",
    "zhHans": "我的两只眼睛都哭红了！",
    "audio": "audio/8aaf9ee747910dc8.m4a"
  },
  {
    "id": "additional-2026-10-29-11-11",
    "zhHans": "我想买一双新鞋。",
    "audio": "audio/df4701d46fabba67.m4a"
  },
  {
    "id": "additional-2026-10-29-11-12",
    "zhHans": "我穿了一件新衣服。",
    "audio": "audio/c4d90f1cd2a849a3.m4a"
  },
  {
    "id": "additional-2026-10-29-11-13",
    "zhHans": "我写了一封信。",
    "audio": "audio/9f3397d90676caac.m4a"
  },
  {
    "id": "additional-2026-10-29-11-14",
    "zhHans": "我坐飞机来的。",
    "audio": "audio/9a1797f1305fb9f3.m4a"
  },
  {
    "id": "additional-2026-10-29-11-15",
    "zhHans": "我看见一架飞机！",
    "audio": "audio/b3d1d6367fcd947b.m4a"
  },
  {
    "id": "additional-2026-10-29-11-16",
    "zhHans": "我想吃一碗面条。",
    "audio": "audio/a0e42149e7af23b6.m4a"
  },
  {
    "id": "additional-2026-10-29-11-17",
    "zhHans": "喝一杯水吧！",
    "audio": "audio/b6769b0ca6597bdf.m4a"
  },
  {
    "id": "additional-2026-10-29-12-1",
    "zhHans": "这里有一个陷阱！",
    "audio": "audio/e2b1135d48515226.m4a"
  },
  {
    "id": "additional-2026-10-29-12-2",
    "zhHans": "桌上有一个棋盘。",
    "audio": "audio/97f84981d178fb16.m4a"
  },
  {
    "id": "additional-2026-10-29-12-3",
    "zhHans": "前面有敌人！",
    "audio": "audio/82d5ad4298c6a3f3.m4a"
  },
  {
    "id": "additional-2026-10-29-12-4",
    "zhHans": "这里没有人帮我！",
    "audio": "audio/6ace07542fda5884.m4a"
  },
  {
    "id": "additional-2026-10-29-12-5",
    "zhHans": "你身边没有人了。",
    "audio": "audio/658692516ff0198f.m4a"
  },
  {
    "id": "additional-2026-10-29-12-6",
    "zhHans": "这里有陷阱吗？",
    "audio": "audio/5605bc295838069e.m4a"
  },
  {
    "id": "additional-2026-10-29-12-7",
    "zhHans": "桌上有水吗？",
    "audio": "audio/f22243028d25347d.m4a"
  },
  {
    "id": "additional-2026-10-29-13-1",
    "zhHans": "国王在哪里？",
    "audio": "audio/6e2a8534dc1457a1.m4a"
  },
  {
    "id": "additional-2026-10-29-13-2",
    "zhHans": "王后不在这里了！",
    "audio": "audio/cfacb586c61b0e4a.m4a"
  },
  {
    "id": "additional-2026-10-29-13-3",
    "zhHans": "敌人在后面！",
    "audio": "audio/fdf93db7ea63ae5b.m4a"
  },
  {
    "id": "additional-2026-10-29-13-4",
    "zhHans": "我在家。",
    "audio": "audio/a4fe9f5a5fabca41.m4a"
  },
  {
    "id": "additional-2026-10-29-13-5",
    "zhHans": "你的朋友不在这儿。",
    "audio": "audio/d90598bbd370d20b.m4a"
  },
  {
    "id": "additional-2026-10-29-13-6",
    "zhHans": "我的朋友都不在了。",
    "audio": "audio/5e480df64ac054bb.m4a"
  },
  {
    "id": "additional-2026-10-29-14-1",
    "zhHans": "看后面！",
    "audio": "audio/c0287f3e418b441d.m4a"
  },
  {
    "id": "additional-2026-10-29-14-2",
    "zhHans": "看前面！",
    "audio": "audio/39e363c93d02a2f0.m4a"
  },
  {
    "id": "additional-2026-10-29-14-3",
    "zhHans": "看左边！",
    "audio": "audio/c5c9e5fc81332ab0.m4a"
  },
  {
    "id": "additional-2026-10-29-14-4",
    "zhHans": "看右边！",
    "audio": "audio/aec8de30d9484a7b.m4a"
  },
  {
    "id": "additional-2026-10-29-14-5",
    "zhHans": "他在我旁边！",
    "audio": "audio/96ea5a6378a510d1.m4a"
  },
  {
    "id": "additional-2026-10-29-14-6",
    "zhHans": "危险在上面！",
    "audio": "audio/39b9f9ca99930d56.m4a"
  },
  {
    "id": "additional-2026-10-29-14-7",
    "zhHans": "下面也有敌人！",
    "audio": "audio/d1b17dc8fde0ac86.m4a"
  },
  {
    "id": "additional-2026-10-29-14-8",
    "zhHans": "我的兵在哪里？",
    "audio": "audio/e56bfb97d47dc3f1.m4a"
  },
  {
    "id": "additional-2026-10-29-14-9",
    "zhHans": "棋盘上有什么？",
    "audio": "audio/29b3410773d0d68c.m4a"
  },
  {
    "id": "additional-2026-10-29-14-10",
    "zhHans": "城堡里只有你。",
    "audio": "audio/5ff722d46f63593f.m4a"
  },
  {
    "id": "additional-2026-10-29-14-11",
    "zhHans": "房间里只有我。",
    "audio": "audio/b84f63b46a0b0f02.m4a"
  },
  {
    "id": "additional-2026-10-29-14-12",
    "zhHans": "门外有人！",
    "audio": "audio/78cc117087d90ed7.m4a"
  },
  {
    "id": "additional-2026-10-29-14-13",
    "zhHans": "敌人在门口！",
    "audio": "audio/b3141342597ca025.m4a"
  },
  {
    "id": "additional-2026-10-29-14-14",
    "zhHans": "国王在城堡里。",
    "audio": "audio/c5eefdc266ee2406.m4a"
  },
  {
    "id": "additional-2026-10-29-15-1",
    "zhHans": "别来这儿！",
    "audio": "audio/99d3bb3efafb6c04.m4a"
  },
  {
    "id": "additional-2026-10-29-15-2",
    "zhHans": "快来这儿！",
    "audio": "audio/e22aefe4b13538e9.m4a"
  },
  {
    "id": "additional-2026-10-29-15-3",
    "zhHans": "别去那儿！",
    "audio": "audio/00cf28adb09b34e2.m4a"
  },
  {
    "id": "additional-2026-10-29-15-4",
    "zhHans": "你怎么到那儿去了？",
    "audio": "audio/cc3189debbbf675b.m4a"
  },
  {
    "id": "additional-2026-10-29-15-5",
    "zhHans": "这里安全吗？",
    "audio": "audio/3ab5a2b86e1fcafc.m4a"
  },
  {
    "id": "additional-2026-10-29-15-6",
    "zhHans": "这里很危险！",
    "audio": "audio/b98141fd9ad4cb17.m4a"
  },
  {
    "id": "additional-2026-10-29-15-7",
    "zhHans": "那里有什么？",
    "audio": "audio/1e47ca3c04e59214.m4a"
  },
  {
    "id": "additional-2026-10-29-15-8",
    "zhHans": "那里不安全！",
    "audio": "audio/efb78f18ab366f2b.m4a"
  },
  {
    "id": "additional-2026-10-29-15-9",
    "zhHans": "你要去哪里？",
    "audio": "audio/c207f870b3e5bcc0.m4a"
  },
  {
    "id": "additional-2026-10-29-15-10",
    "zhHans": "我该去哪里？",
    "audio": "audio/f9b433793ebda2bb.m4a"
  },
  {
    "id": "additional-2026-10-29-15-11",
    "zhHans": "你那儿有棋盘吗？",
    "audio": "audio/c64d6f73200fe558.m4a"
  },
  {
    "id": "additional-2026-10-29-15-12",
    "zhHans": "我这儿有水。",
    "audio": "audio/1cb1c7c047fb1964.m4a"
  },
  {
    "id": "additional-2026-10-29-15-13",
    "zhHans": "你朋友那儿还有人吗？",
    "audio": "audio/86abb826693691eb.m4a"
  },
  {
    "id": "additional-2026-10-29-16-1",
    "zhHans": "你非常聪明！",
    "audio": "audio/a84887a6b190469a.m4a"
  },
  {
    "id": "additional-2026-10-29-16-2",
    "zhHans": "你非常厉害！",
    "audio": "audio/13dc80c9493b75fc.m4a"
  },
  {
    "id": "additional-2026-10-29-16-3",
    "zhHans": "今天比较热。",
    "audio": "audio/0ef2bc34bf7c5ca9.m4a"
  },
  {
    "id": "additional-2026-10-29-16-4",
    "zhHans": "这局比较难。",
    "audio": "audio/054b243754c9be61.m4a"
  },
  {
    "id": "additional-2026-10-29-16-5",
    "zhHans": "我有点儿紧张。",
    "audio": "audio/fc3a711dcf6410cc.m4a"
  },
  {
    "id": "additional-2026-10-29-16-6",
    "zhHans": "我有点儿害怕。",
    "audio": "audio/404beb304cb53cc9.m4a"
  },
  {
    "id": "additional-2026-10-29-16-7",
    "zhHans": "我有点儿累了。",
    "audio": "audio/38bb38e23b4395b3.m4a"
  },
  {
    "id": "additional-2026-10-29-17-1",
    "zhHans": "我不开心。",
    "audio": "audio/344f17a2f4617e0f.m4a"
  },
  {
    "id": "additional-2026-10-29-17-2",
    "zhHans": "我不害怕！",
    "audio": "audio/8e9931876a7004c9.m4a"
  },
  {
    "id": "additional-2026-10-29-17-3",
    "zhHans": "我不很高兴。",
    "audio": "audio/493499308a42cc8c.m4a"
  },
  {
    "id": "additional-2026-10-29-17-4",
    "zhHans": "我很不高兴！",
    "audio": "audio/6b7483ddafbcd369.m4a"
  },
  {
    "id": "additional-2026-10-29-17-5",
    "zhHans": "今天不很冷。",
    "audio": "audio/162931ea7b9675b8.m4a"
  },
  {
    "id": "additional-2026-10-29-17-6",
    "zhHans": "你太快了！",
    "audio": "audio/34199f23ba7449f0.m4a"
  },
  {
    "id": "additional-2026-10-29-17-7",
    "zhHans": "这太危险了！",
    "audio": "audio/807cacecbb3ac25b.m4a"
  },
  {
    "id": "additional-2026-10-29-18-1",
    "zhHans": "你忙不忙？",
    "audio": "audio/a7cc5d526f75404f.m4a"
  },
  {
    "id": "additional-2026-10-29-18-2",
    "zhHans": "你紧张不紧张？",
    "audio": "audio/f7aff31079d0a1a2.m4a"
  },
  {
    "id": "additional-2026-10-29-18-3",
    "zhHans": "你累不累？",
    "audio": "audio/c1af9e5b1e5d91c5.m4a"
  },
  {
    "id": "additional-2026-10-29-18-4",
    "zhHans": "这一步难不难？",
    "audio": "audio/d6bf95f31560fe9e.m4a"
  },
  {
    "id": "additional-2026-10-29-18-5",
    "zhHans": "这局有多难？",
    "audio": "audio/bd4aa5214e97d5c5.m4a"
  },
  {
    "id": "additional-2026-10-29-18-6",
    "zhHans": "你觉得这局怎么样？",
    "audio": "audio/4062810c21ac811e.m4a"
  },
  {
    "id": "additional-2026-10-29-19-1",
    "zhHans": "这是一个很好的办法。",
    "audio": "audio/b6af972c9c715b2b.m4a"
  },
  {
    "id": "additional-2026-10-29-19-2",
    "zhHans": "你是一个很强的对手。",
    "audio": "audio/b3d5c059b06176b2.m4a"
  },
  {
    "id": "additional-2026-10-29-19-3",
    "zhHans": "今天是非常重要的一天。",
    "audio": "audio/7a7e4fa86d679185.m4a"
  },
  {
    "id": "additional-2026-10-29-19-4",
    "zhHans": "这是一个非常好的主意！",
    "audio": "audio/d73d2a9ba2dd4c11.m4a"
  },
  {
    "id": "additional-2026-10-29-19-5",
    "zhHans": "这是一场挺有意思的比赛。",
    "audio": "audio/365b25e0408459c0.m4a"
  },
  {
    "id": "additional-2026-10-29-20-1",
    "zhHans": "我想喝热热的茶。",
    "audio": "audio/d1fbc9b10a0654a4.m4a"
  },
  {
    "id": "additional-2026-10-29-20-2",
    "zhHans": "我的小小的梦想破灭了。",
    "audio": "audio/02302d132c0262d1.m4a"
  },
  {
    "id": "additional-2026-10-29-21-1",
    "zhHans": "这是你想的办法吗？",
    "audio": "audio/989ed2a376fde783.m4a"
  },
  {
    "id": "additional-2026-10-29-21-2",
    "zhHans": "这是我写的书。",
    "audio": "audio/7940e97db21a04f1.m4a"
  },
  {
    "id": "additional-2026-10-29-22-1",
    "zhHans": "我有很多问题！",
    "audio": "audio/a2585a4d58fe71b2.m4a"
  },
  {
    "id": "additional-2026-10-29-22-2",
    "zhHans": "你有不少好办法！",
    "audio": "audio/c589e35a05f30e47.m4a"
  },
  {
    "id": "additional-2026-10-29-22-3",
    "zhHans": "今天学了很多东西。",
    "audio": "audio/ae5104c36cbffd37.m4a"
  },
  {
    "id": "additional-2026-10-29-22-4",
    "zhHans": "我还有很多要学的东西。",
    "audio": "audio/2f078bc8ced7c4a1.m4a"
  },
  {
    "id": "additional-2026-10-29-23-1",
    "zhHans": "这局不很难。",
    "audio": "audio/17d669666ed6f854.m4a"
  },
  {
    "id": "translated-1-1",
    "zhHans": "他被关进监狱了。",
    "audio": "audio/2ebd8176cb0e3f51.m4a"
  },
  {
    "id": "translated-1-2",
    "zhHans": "我在打扫房间。",
    "audio": "audio/d2e0170164ee91f1.m4a"
  },
  {
    "id": "translated-1-3",
    "zhHans": "我在收拾桌上的东西。",
    "audio": "audio/5f5f437f1796a9a9.m4a"
  },
  {
    "id": "translated-2-1",
    "zhHans": "可惜，兵消失了。",
    "audio": "audio/568b4f8648c697c1.m4a"
  },
  {
    "id": "translated-2-2",
    "zhHans": "那可是我喜欢的兵！",
    "audio": "audio/b7f25a072cf4ef93.m4a"
  },
  {
    "id": "translated-2-3",
    "zhHans": "他们只是我的手和脚。",
    "audio": "audio/6f6a51ebf57a450d.m4a"
  },
  {
    "id": "translated-3-1",
    "zhHans": "再见了。",
    "audio": "audio/8a9b033f0414abb5.m4a"
  },
  {
    "id": "translated-4-1",
    "zhHans": "我那匹可爱的马啊！",
    "audio": "audio/7c94acc3cb6bc618.m4a"
  },
  {
    "id": "translated-4-2",
    "zhHans": "我刚买了它！",
    "audio": "audio/c97f976d20718e72.m4a"
  },
  {
    "id": "translated-5-1",
    "zhHans": "呼，热起来了！",
    "audio": "audio/625938a26a36efb0.m4a"
  },
  {
    "id": "translated-6-1",
    "zhHans": "再见了。",
    "audio": "audio/8a9b033f0414abb5.m4a"
  },
  {
    "id": "translated-7-1",
    "zhHans": "你累了吗？",
    "audio": "audio/40260f4c7c160909.m4a"
  },
  {
    "id": "translated-7-2",
    "zhHans": "再见了。",
    "audio": "audio/8a9b033f0414abb5.m4a"
  },
  {
    "id": "translated-7-3",
    "zhHans": "我攻下了移动的城堡！",
    "audio": "audio/28253f2cc2bd0d3b.m4a"
  },
  {
    "id": "translated-7-4",
    "zhHans": "你的车？我给你洗！",
    "audio": "audio/bfd2e1ff131f18ba.m4a"
  },
  {
    "id": "translated-8-1",
    "zhHans": "喝杯咖啡，冷静一下。",
    "audio": "audio/10b54496f0dec30c.m4a"
  },
  {
    "id": "translated-8-2",
    "zhHans": "喝点水，冷静一下。",
    "audio": "audio/cd4c1e01f3d6caee.m4a"
  },
  {
    "id": "translated-9-1",
    "zhHans": "别生气啊！",
    "audio": "audio/4f60440c660c3901.m4a"
  },
  {
    "id": "translated-9-2",
    "zhHans": "再见了。",
    "audio": "audio/8a9b033f0414abb5.m4a"
  },
  {
    "id": "translated-9-3",
    "zhHans": "怎么了？脸都白了！",
    "audio": "audio/6be1430aa4015e51.m4a"
  },
  {
    "id": "translated-9-4",
    "zhHans": "我胸口很疼。",
    "audio": "audio/cda443da6afa5c13.m4a"
  },
  {
    "id": "translated-9-5",
    "zhHans": "王后……死了……",
    "audio": "audio/69488c88a9bdc094.m4a"
  },
  {
    "id": "translated-10-1",
    "zhHans": "我想回家了。",
    "audio": "audio/54e0be64376722a6.m4a"
  },
  {
    "id": "translated-10-2",
    "zhHans": "我快哭了。",
    "audio": "audio/aaa291ace6463d8d.m4a"
  },
  {
    "id": "translated-10-3",
    "zhHans": "啊，头好疼。",
    "audio": "audio/d204f8d5f3cf4cb3.m4a"
  },
  {
    "id": "translated-10-4",
    "zhHans": "王后……死了……",
    "audio": "audio/69488c88a9bdc094.m4a"
  },
  {
    "id": "translated-10-5",
    "zhHans": "你有一颗冰冷的心！",
    "audio": "audio/03ed1db46bb10786.m4a"
  },
  {
    "id": "translated-11-1",
    "zhHans": "这局真好玩！",
    "audio": "audio/8e39ea22df38df0c.m4a"
  },
  {
    "id": "translated-12-1",
    "zhHans": "你是白方。",
    "audio": "audio/802e7faec78f8c2f.m4a"
  },
  {
    "id": "translated-12-2",
    "zhHans": "我是黑方。",
    "audio": "audio/f2667cfe53c9e750.m4a"
  },
  {
    "id": "translated-13-1",
    "zhHans": "你是黑方。",
    "audio": "audio/e86505e27f660903.m4a"
  },
  {
    "id": "translated-13-2",
    "zhHans": "我是白方。",
    "audio": "audio/d439962beee42ec9.m4a"
  },
  {
    "id": "translated-14-1",
    "zhHans": "听说国际象棋起源于印度。",
    "audio": "audio/e88b7ceb8d635ffc.m4a"
  },
  {
    "id": "translated-14-2",
    "zhHans": "我们下棋吧！",
    "audio": "audio/37e850dc02bda083.m4a"
  },
  {
    "id": "translated-14-3",
    "zhHans": "你是白方。",
    "audio": "audio/802e7faec78f8c2f.m4a"
  },
  {
    "id": "translated-14-4",
    "zhHans": "你是黑方。",
    "audio": "audio/e86505e27f660903.m4a"
  },
  {
    "id": "translated-14-5",
    "zhHans": "我是白方。",
    "audio": "audio/d439962beee42ec9.m4a"
  },
  {
    "id": "translated-14-6",
    "zhHans": "我是黑方。",
    "audio": "audio/f2667cfe53c9e750.m4a"
  },
  {
    "id": "translated-14-7",
    "zhHans": "你怕输吗？",
    "audio": "audio/0556e148fa02a58d.m4a"
  },
  {
    "id": "translated-14-8",
    "zhHans": "我一定会赢！",
    "audio": "audio/33e24477a1bbab92.m4a"
  },
  {
    "id": "translated-14-9",
    "zhHans": "欢迎来到国际象棋学校！",
    "audio": "audio/7bfc6be4bab26cd5.m4a"
  },
  {
    "id": "translated-14-10",
    "zhHans": "我们开始吧！",
    "audio": "audio/0040f02d324698ad.m4a"
  },
  {
    "id": "translated-14-11",
    "zhHans": "我是老师，你是学生。",
    "audio": "audio/770d2df54e1f912a.m4a"
  },
  {
    "id": "translated-15-1",
    "zhHans": "我去找国王了！",
    "audio": "audio/6b44b5f36350de13.m4a"
  },
  {
    "id": "translated-15-2",
    "zhHans": "你逃不掉了！",
    "audio": "audio/538e044da0b7cac4.m4a"
  },
  {
    "id": "translated-15-3",
    "zhHans": "小心背后！",
    "audio": "audio/5cbd680eea1d6710.m4a"
  },
  {
    "id": "translated-16-1",
    "zhHans": "陛下要过来了！让路！",
    "audio": "audio/85fc2fab39a49238.m4a"
  },
  {
    "id": "translated-16-2",
    "zhHans": "别过来！",
    "audio": "audio/cde6a4e8a86f5df9.m4a"
  },
  {
    "id": "translated-16-3",
    "zhHans": "这是叛乱！",
    "audio": "audio/4fa946c53f00921d.m4a"
  },
  {
    "id": "translated-17-1",
    "zhHans": "赢了，开心吗？太好了！",
    "audio": "audio/09c58cd0f8db47ac.m4a"
  },
  {
    "id": "translated-17-2",
    "zhHans": "国破山河在。",
    "audio": "audio/c7fb4cd4ca1ad62f.m4a"
  },
  {
    "id": "translated-17-3",
    "zhHans": "我讨厌输。",
    "audio": "audio/3ec3df6933a85cbe.m4a"
  },
  {
    "id": "translated-17-4",
    "zhHans": "你比我强！",
    "audio": "audio/9f587aebcf544a3d.m4a"
  },
  {
    "id": "translated-17-5",
    "zhHans": "别告诉我妈妈！",
    "audio": "audio/d5dfa9b826b17bf4.m4a"
  },
  {
    "id": "translated-17-6",
    "zhHans": "别告诉我爸爸！",
    "audio": "audio/599b28978e4f049f.m4a"
  },
  {
    "id": "translated-17-7",
    "zhHans": "明天我会赢！",
    "audio": "audio/d95554b0f4c083b6.m4a"
  },
  {
    "id": "translated-18-1",
    "zhHans": "借你一本棋书？",
    "audio": "audio/8392b1114de3d11b.m4a"
  },
  {
    "id": "translated-18-2",
    "zhHans": "比赛结束了。",
    "audio": "audio/a1c453526d321e61.m4a"
  },
  {
    "id": "translated-18-3",
    "zhHans": "弱一点也没关系。",
    "audio": "audio/08b8dfd07d2dd198.m4a"
  },
  {
    "id": "translated-18-4",
    "zhHans": "不甘心吗？",
    "audio": "audio/cd31caccb568e1e0.m4a"
  },
  {
    "id": "translated-18-5",
    "zhHans": "真该录个视频！",
    "audio": "audio/5503df96fa01d57b.m4a"
  },
  {
    "id": "translated-18-6",
    "zhHans": "明天再下吧！",
    "audio": "audio/63b3aa8f7e7bc720.m4a"
  },
  {
    "id": "translated-19-1",
    "zhHans": "你看到了吗？",
    "audio": "audio/ae9bb49170dab320.m4a"
  },
  {
    "id": "translated-19-2",
    "zhHans": "王侯将相，宁有种乎！",
    "audio": "audio/f23cabfae87d0b0e.m4a"
  },
  {
    "id": "translated-20-1",
    "zhHans": "〇〇出现了！",
    "audio": "audio/820dcd5ffe0bc61d.m4a"
  },
  {
    "id": "translated-20-2",
    "zhHans": "王后回来了！",
    "audio": "audio/08cff971ddd9510b.m4a"
  },
  {
    "id": "translated-21-1",
    "zhHans": "我不会放弃！",
    "audio": "audio/fe27c2b7c24d5c57.m4a"
  },
  {
    "id": "translated-21-2",
    "zhHans": "救命！",
    "audio": "audio/bf084d3f4dc3255d.m4a"
  },
  {
    "id": "translated-21-3",
    "zhHans": "借我手机！我要打电话求救！",
    "audio": "audio/2e4f9ae00029a312.m4a"
  },
  {
    "id": "translated-22-1",
    "zhHans": "只剩你一个了。",
    "audio": "audio/69d9bb7d0084006b.m4a"
  },
  {
    "id": "translated-22-2",
    "zhHans": "寂寞吗？",
    "audio": "audio/c64b0283d0bcf909.m4a"
  },
  {
    "id": "translated-22-3",
    "zhHans": "陛下，您寂寞吗？",
    "audio": "audio/03b5dc1f18b254a6.m4a"
  },
  {
    "id": "translated-23-1",
    "zhHans": "早上好！",
    "audio": "audio/c79f729fc9d53085.m4a"
  },
  {
    "id": "translated-23-2",
    "zhHans": "你起得真早！",
    "audio": "audio/255f0950963a6e13.m4a"
  },
  {
    "id": "translated-23-3",
    "zhHans": "外面很亮。",
    "audio": "audio/b59ba3c8ec35c3c5.m4a"
  },
  {
    "id": "translated-24-1",
    "zhHans": "晚上好！",
    "audio": "audio/e21a4da5c6387fc7.m4a"
  },
  {
    "id": "translated-24-2",
    "zhHans": "现在？你不困吗？",
    "audio": "audio/2b30156047d84160.m4a"
  },
  {
    "id": "translated-24-3",
    "zhHans": "你睡得真晚！",
    "audio": "audio/33d3fc3d9315e575.m4a"
  },
  {
    "id": "translated-24-4",
    "zhHans": "外面已经黑了。",
    "audio": "audio/82ec5a73aad467a8.m4a"
  },
  {
    "id": "translated-24-5",
    "zhHans": "现在几点了？",
    "audio": "audio/854dcc5a6850252b.m4a"
  },
  {
    "id": "translated-25-1",
    "zhHans": "陛下进城堡了！",
    "audio": "audio/f1721be01dec097d.m4a"
  },
  {
    "id": "translated-26-1",
    "zhHans": "陛下，请出来！",
    "audio": "audio/23ead7c76326d977.m4a"
  },
  {
    "id": "translated-27-1",
    "zhHans": "又见面了！",
    "audio": "audio/337ccc1dd1311a0b.m4a"
  },
  {
    "id": "translated-27-2",
    "zhHans": "今天都见你好几次了！",
    "audio": "audio/5c3dd92679f1a4fd.m4a"
  },
  {
    "id": "translated-28-1",
    "zhHans": "真快！",
    "audio": "audio/c238433676885315.m4a"
  },
  {
    "id": "translated-28-2",
    "zhHans": "太快了！",
    "audio": "audio/3d0ba42e6169a0b8.m4a"
  },
  {
    "id": "translated-29-1",
    "zhHans": "形势逆转了！",
    "audio": "audio/2d54a73dd95345ea.m4a"
  },
  {
    "id": "translated-30-1",
    "zhHans": "求你了，等一下！",
    "audio": "audio/215cbda049ca7824.m4a"
  },
  {
    "id": "translated-31-1",
    "zhHans": "小时候，爷爷教过我。",
    "audio": "audio/b2e93fdd9f7a00f9.m4a"
  },
  {
    "id": "translated-31-2",
    "zhHans": "小时候，奶奶教过我。",
    "audio": "audio/570e9a446cce0002.m4a"
  }
]