[
  {
    "id": "additional-2026-10-29-1-1",
    "zhHans": "我不喜欢输。",
    "audio": "audio/2c67a6c389b0237f.m4a"
  },
  {
    "id": "additional-2026-10-29-1-2",
    "zhHans": "我不走！",
    "audio": "audio/0a6a8598f6a1a64e.m4a"
  },
  {
    "id": "additional-2026-10-29-1-3",
    "zhHans": "你也喜欢下棋吗？",
    "audio": "audio/d7fad370fc695d5a.m4a"
  },
  {
    "id": "additional-2026-10-29-1-4",
    "zhHans": "我也来了！",
    "audio": "audio/5a889f225a7b2320.m4a"
  },
  {
    "id": "additional-2026-10-29-1-5",
    "zhHans": "我们都准备好了。",
    "audio": "audio/14c390b52624e030.m4a"
  },
  {
    "id": "additional-2026-10-29-2-1",
    "zhHans": "咱们开始吧！",
    "audio": "audio/695d4bccdb76f7ba.m4a"
  },
  {
    "id": "additional-2026-10-29-2-2",
    "zhHans": "咱们再来一局！",
    "audio": "audio/7d3f58fee8a7359c.m4a"
  },
  {
    "id": "additional-2026-10-29-2-3",
    "zhHans": "咱们明天再玩吧！",
    "audio": "audio/98d8cda7820d2520.m4a"
  },
  {
    "id": "additional-2026-10-29-2-4",
    "zhHans": "你们准备好了吗？",
    "audio": "audio/f210c8674da174c6.m4a"
  },
  {
    "id": "additional-2026-10-29-2-5",
    "zhHans": "你们真厉害！",
    "audio": "audio/a67e29896b0e7c48.m4a"
  },
  {
    "id": "additional-2026-10-29-2-6",
    "zhHans": "你们起得真早！",
    "audio": "audio/dd2f1e68fe7640dd.m4a"
  },
  {
    "id": "additional-2026-10-29-2-7",
    "zhHans": "大家准备好了吗？",
    "audio": "audio/f700ca00da48f66d.m4a"
  },
  {
    "id": "additional-2026-10-29-2-8",
    "zhHans": "大家都笑我！",
    "audio": "audio/5babea8ae08d7553.m4a"
  },
  {
    "id": "additional-2026-10-29-3-1",
    "zhHans": "她是我的朋友。",
    "audio": "audio/1658b6bc57df48f8.m4a"
  },
  {
    "id": "additional-2026-10-29-3-2",
    "zhHans": "她跑得真快！",
    "audio": "audio/efd88687c2f57b5e.m4a"
  },
  {
    "id": "additional-2026-10-29-3-3",
    "zhHans": "她回来了！",
    "audio": "audio/b7def35371dbe276.m4a"
  },
  {
    "id": "additional-2026-10-29-3-4",
    "zhHans": "她们都走了。",
    "audio": "audio/75d63a70413fa195.m4a"
  },
  {
    "id": "additional-2026-10-29-3-5",
    "zhHans": "他们都走了。",
    "audio": "audio/5c966deaafaf3b84.m4a"
  },
  {
    "id": "additional-2026-10-29-3-6",
    "zhHans": "他们不在这里。",
    "audio": "audio/8f30e352b86c51ca.m4a"
  },
  {
    "id": "additional-2026-10-29-4-1",
    "zhHans": "它不见了！",
    "audio": "audio/29997cfae2c045ed.m4a"
  },
  {
    "id": "additional-2026-10-29-4-2",
    "zhHans": "它去哪儿了？",
    "audio": "audio/3abd448e165e9604.m4a"
  },
  {
    "id": "additional-2026-10-29-4-3",
    "zhHans": "它变了！",
    "audio": "audio/3e00a49d85e65beb.m4a"
  },
  {
    "id": "additional-2026-10-29-4-4",
    "zhHans": "它们去哪儿了？",
    "audio": "audio/35fc5b7a83f7854d.m4a"
  },
  {
    "id": "additional-2026-10-29-4-5",
    "zhHans": "我自己来！",
    "audio": "audio/93562ab018373683.m4a"
  },
  {
    "id": "additional-2026-10-29-4-6",
    "zhHans": "你自己来吗？",
    "audio": "audio/62f11b5b4c7987ce.m4a"
  },
  {
    "id": "additional-2026-10-29-4-7",
    "zhHans": "别告诉别人！",
    "audio": "audio/b54208e1f73a459b.m4a"
  },
  {
    "id": "additional-2026-10-29-4-8",
    "zhHans": "人家不想输嘛！",
    "audio": "audio/3d36be52024a05ff.m4a"
  },
  {
    "id": "additional-2026-10-29-5-1",
    "zhHans": "你不是黑方。",
    "audio": "audio/bb8080f08df1ab56.m4a"
  },
  {
    "id": "additional-2026-10-29-5-2",
    "zhHans": "我不是黑方。",
    "audio": "audio/2b55493868c19bc7.m4a"
  },
  {
    "id": "additional-2026-10-29-5-3",
    "zhHans": "这不是玩笑！",
    "audio": "audio/33b85b6ed3f1dc8f.m4a"
  },
  {
    "id": "additional-2026-10-29-5-4",
    "zhHans": "你是学生吗？",
    "audio": "audio/c236163a845f910e.m4a"
  },
  {
    "id": "additional-2026-10-29-5-5",
    "zhHans": "这是你的棋盘吗？",
    "audio": "audio/507cd36dd3b7e5d7.m4a"
  },
  {
    "id": "additional-2026-10-29-5-6",
    "zhHans": "这是你的计划吗？",
    "audio": "audio/dd84aa3c51ebd760.m4a"
  },
  {
    "id": "additional-2026-10-29-5-7",
    "zhHans": "我也是学生。",
    "audio": "audio/a3cba71b8065488e.m4a"
  },
  {
    "id": "additional-2026-10-29-5-8",
    "zhHans": "她也是王后！",
    "audio": "audio/88baf11d614873aa.m4a"
  },
  {
    "id": "additional-2026-10-29-5-9",
    "zhHans": "我们都是学生。",
    "audio": "audio/cec2fdfa181d30cb.m4a"
  },
  {
    "id": "additional-2026-10-29-5-10",
    "zhHans": "我也不是每次都赢。",
    "audio": "audio/b7667cf8f262c82e.m4a"
  },
  {
    "id": "additional-2026-10-29-6-1",
    "zhHans": "这个很好！",
    "audio": "audio/3b88b142c22c4e8e.m4a"
  },
  {
    "id": "additional-2026-10-29-6-2",
    "zhHans": "那个更好！",
    "audio": "audio/a11a25ad863db09c.m4a"
  },
  {
    "id": "additional-2026-10-29-6-3",
    "zhHans": "这个游戏真有趣！",
    "audio": "audio/50dd88d3a8df1d32.m4a"
  },
  {
    "id": "additional-2026-10-29-6-4",
    "zhHans": "那个办法真好！",
    "audio": "audio/861698473590657a.m4a"
  },
  {
    "id": "additional-2026-10-29-6-5",
    "zhHans": "你喜欢哪个？",
    "audio": "audio/c6faa66a017ed898.m4a"
  },
  {
    "id": "additional-2026-10-29-6-6",
    "zhHans": "你要哪个？",
    "audio": "audio/a0a5ea699dc393da.m4a"
  },
  {
    "id": "additional-2026-10-29-6-7",
    "zhHans": "哪匹马不见了？",
    "audio": "audio/8ef61888881e5ab0.m4a"
  },
  {
    "id": "additional-2026-10-29-6-8",
    "zhHans": "这些是谁的？",
    "audio": "audio/83388de8b97ee97a.m4a"
  },
  {
    "id": "additional-2026-10-29-6-9",
    "zhHans": "那些都是我的！",
    "audio": "audio/7e062b48aa0b4d40.m4a"
  },
  {
    "id": "additional-2026-10-29-6-10",
    "zhHans": "这些是什么？",
    "audio": "audio/121d4cf816c9d453.m4a"
  },
  {
    "id": "additional-2026-10-29-6-11",
    "zhHans": "哪些是你的？",
    "audio": "audio/90bcf38d39629954.m4a"
  },
  {
    "id": "additional-2026-10-29-6-12",
    "zhHans": "那些兵都去哪儿了？",
    "audio": "audio/2d7de0236241b372.m4a"
  },
  {
    "id": "additional-2026-10-29-7-1",
    "zhHans": "这是中国的游戏吗？",
    "audio": "audio/4e88f1a8d32cf975.m4a"
  },
  {
    "id": "additional-2026-10-29-7-2",
    "zhHans": "这是我的，你的是那个。",
    "audio": "audio/1ee7eaef230c99e9.m4a"
  },
  {
    "id": "additional-2026-10-29-7-3",
    "zhHans": "白色的是你的。",
    "audio": "audio/39949c9ae79bccb5.m4a"
  },
  {
    "id": "additional-2026-10-29-7-4",
    "zhHans": "黑色的是你的。",
    "audio": "audio/84e349389db397ba.m4a"
  },
  {
    "id": "additional-2026-10-29-7-5",
    "zhHans": "我的老师喜欢下棋。",
    "audio": "audio/5716f2292f5e051b.m4a"
  },
  {
    "id": "additional-2026-10-29-7-6",
    "zhHans": "我老师会生气的！",
    "audio": "audio/4edae79355193d88.m4a"
  },
  {
    "id": "additional-2026-10-29-7-7",
    "zhHans": "我们学校也有棋社。",
    "audio": "audio/09f67828bb9d4aa9.m4a"
  },
  {
    "id": "additional-2026-10-29-7-8",
    "zhHans": "我家有棋盘。",
    "audio": "audio/f87143b3e1e348f1.m4a"
  },
  {
    "id": "additional-2026-10-29-7-9",
    "zhHans": "这是一个重要的问题。",
    "audio": "audio/7ddc7adebadcc42d.m4a"
  },
  {
    "id": "additional-2026-10-29-7-10",
    "zhHans": "这是一个好办法！",
    "audio": "audio/ee036e35f2905c43.m4a"
  },
  {
    "id": "additional-2026-10-29-8-1",
    "zhHans": "你玩不玩？",
    "audio": "audio/f56c3223a196bb02.m4a"
  },
  {
    "id": "additional-2026-10-29-8-2",
    "zhHans": "你来不来？",
    "audio": "audio/9ea3e404c9505d8e.m4a"
  },
  {
    "id": "additional-2026-10-29-8-3",
    "zhHans": "你走不走？",
    "audio": "audio/ecd44a0bab606e70.m4a"
  },
  {
    "id": "additional-2026-10-29-8-4",
    "zhHans": "你是不是学生？",
    "audio": "audio/73df41c651851ef4.m4a"
  },
  {
    "id": "additional-2026-10-29-8-5",
    "zhHans": "这是不是将军？",
    "audio": "audio/f729a02007e575a0.m4a"
  },
  {
    "id": "additional-2026-10-29-8-6",
    "zhHans": "这是不是陷阱？",
    "audio": "audio/763c1caa50c9c5a0.m4a"
  },
  {
    "id": "additional-2026-10-29-8-7",
    "zhHans": "你想不想再玩？",
    "audio": "audio/f7ba2342bd3c3edf.m4a"
  },
  {
    "id": "additional-2026-10-29-8-8",
    "zhHans": "你下不下棋？",
    "audio": "audio/d580966957d94223.m4a"
  },
  {
    "id": "additional-2026-10-29-8-9",
    "zhHans": "你喝不喝水？",
    "audio": "audio/1c9fa29c4f865c37.m4a"
  },
  {
    "id": "additional-2026-10-29-8-10",
    "zhHans": "你下棋不下？",
    "audio": "audio/14830e9e769fee93.m4a"
  },
  {
    "id": "additional-2026-10-29-8-11",
    "zhHans": "你喝水不喝？",
    "audio": "audio/8f072ee419df97d9.m4a"
  },
  {
    "id": "additional-2026-10-29-9-1",
    "zhHans": "这是什么？",
    "audio": "audio/1eab2b336f52c617.m4a"
  },
  {
    "id": "additional-2026-10-29-9-2",
    "zhHans": "你想干什么？",
    "audio": "audio/f715a5f1e7879104.m4a"
  },
  {
    "id": "additional-2026-10-29-9-3",
    "zhHans": "谁干的？",
    "audio": "audio/b7e94a128b0be579.m4a"
  },
  {
    "id": "additional-2026-10-29-9-4",
    "zhHans": "谁教你的？",
    "audio": "audio/115afdce2ee31023.m4a"
  },
  {
    "id": "additional-2026-10-29-9-5",
    "zhHans": "你的朋友在哪儿？",
    "audio": "audio/7964b04a307f3f43.m4a"
  },
  {
    "id": "additional-2026-10-29-9-6",
    "zhHans": "我的朋友去哪儿了？",
    "audio": "audio/c99c744f21ead9b8.m4a"
  },
  {
    "id": "additional-2026-10-29-9-7",
    "zhHans": "你什么时候回家？",
    "audio": "audio/56e8860c48404f1d.m4a"
  },
  {
    "id": "additional-2026-10-29-9-8",
    "zhHans": "你什么时候学的棋？",
    "audio": "audio/2cde23c7f59017d3.m4a"
  },
  {
    "id": "additional-2026-10-29-9-9",
    "zhHans": "为什么是她？",
    "audio": "audio/044b8becf5a08c8a.m4a"
  },
  {
    "id": "additional-2026-10-29-9-10",
    "zhHans": "为什么走这一步？",
    "audio": "audio/e6a5771c436e9e12.m4a"
  },
  {
    "id": "additional-2026-10-29-9-11",
    "zhHans": "今天怎么样？",
    "audio": "audio/18bab958bbef3d76.m4a"
  },
  {
    "id": "additional-2026-10-29-9-12",
    "zhHans": "这局怎么样？",
    "audio": "audio/102cda95d9828660.m4a"
  },
  {
    "id": "additional-2026-10-29-9-13",
    "zhHans": "你觉得怎么样？",
    "audio": "audio/0206c9a54254e284.m4a"
  },
  {
    "id": "additional-2026-10-29-10-1",
    "zhHans": "你有好办法！",
    "audio": "audio/56ae43a61b834499.m4a"
  },
  {
    "id": "additional-2026-10-29-10-2",
    "zhHans": "你有兄弟姐妹吗？",
    "audio": "audio/46fac76cbfae2d2f.m4a"
  },
  {
    "id": "additional-2026-10-29-10-3",
    "zhHans": "你没有朋友了吗？",
    "audio": "audio/5b375c0b140093b2.m4a"
  },
  {
    "id": "additional-2026-10-29-10-4",
    "zhHans": "我没有办法了！",
    "audio": "audio/fc317a74cca4a29a.m4a"
  },
  {
    "id": "additional-2026-10-29-10-5",
    "zhHans": "你有没有秘密？",
    "audio": "audio/5a85863c94bc7ae7.m4a"
  },
  {
    "id": "additional-2026-10-29-10-6",
    "zhHans": "你有没有棋盘？",
    "audio": "audio/eeb7b90025f6e3d8.m4a"
  },
  {
    "id": "additional-2026-10-29-10-7",
    "zhHans": "你有没有办法？",
    "audio": "audio/44b02371f0ab480a.m4a"
  },
  {
    "id": "additional-2026-10-29-10-8",
    "zhHans": "你有计划没有？",
    "audio": "audio/104790ae659d79f4.m4a"
  },
  {
    "id": "additional-2026-10-29-11-1",
    "zhHans": "这一步真好！",
    "audio": "audio/ad1316522b531ea3.m4a"
  },
  {
    "id": "additional-2026-10-29-11-2",
    "zhHans": "再来一局！",
    "audio": "audio/0fc3df721869711f.m4a"
  },
  {
    "id": "additional-2026-10-29-11-3",
    "zhHans": "我带了一本书。",
    "audio": "audio/4209ba232925162e.m4a"
  },
  {
    "id": "additional-2026-10-29-11-4",
    "zhHans": "我给你一张照片。",
    "audio": "audio/b3627fafcb17aef1.m4a"
  },
  {
    "id": "additional-2026-10-29-11-5",
    "zhHans": "我要一把椅子。",
    "audio": "audio/9cc0977d00074da9.m4a"
  },
  {
    "id": "additional-2026-10-29-11-6",
    "zhHans": "我想吃一条鱼。",
    "audio": "audio/b899e376ba186f8e.m4a"
  },
  {
    "id": "additional-2026-10-29-11-7",
    "zhHans": "给我一枝笔。",
    "audio": "audio/4d2fa2c244029c95.m4a"
  },
  {
    "id": "additional-2026-10-29-11-8",
    "zhHans": "我想吃一块蛋糕。",
    "audio": "audio/e19c664308e5f940.m4a"
  },
  {
    "id": "additional-2026-10-29-11-9",
    "zhHans": "我坐那辆车回家。",
    "audio": "audio/cd110bfbf8f35ad8.m4a"
  },
  {
    "id": "additional-2026-10-29-11-10",
    "zhHans": "我的两只眼睛都哭红了！",
    "audio": "audio/d2b9a41da6eaa5f1.m4a"
  },
  {
    "id": "additional-2026-10-29-11-11",
    "zhHans": "我想买一双新鞋。",
    "audio": "audio/b5d7962b1dc8a020.m4a"
  },
  {
    "id": "additional-2026-10-29-11-12",
    "zhHans": "我穿了一件新衣服。",
    "audio": "audio/817b30ecaf601744.m4a"
  },
  {
    "id": "additional-2026-10-29-11-13",
    "zhHans": "我写了一封信。",
    "audio": "audio/f8c5d1d543567fa1.m4a"
  },
  {
    "id": "additional-2026-10-29-11-14",
    "zhHans": "我坐飞机来的。",
    "audio": "audio/5e8a45ed08f64e02.m4a"
  },
  {
    "id": "additional-2026-10-29-11-15",
    "zhHans": "我看见一架飞机！",
    "audio": "audio/d07205da307a6ad7.m4a"
  },
  {
    "id": "additional-2026-10-29-11-16",
    "zhHans": "我想吃一碗面条。",
    "audio": "audio/733aa4bcf4ec422c.m4a"
  },
  {
    "id": "additional-2026-10-29-11-17",
    "zhHans": "喝一杯水吧！",
    "audio": "audio/7ca47d9e536bbc07.m4a"
  },
  {
    "id": "additional-2026-10-29-12-1",
    "zhHans": "这里有一个陷阱！",
    "audio": "audio/fe5c06cf6e0a135a.m4a"
  },
  {
    "id": "additional-2026-10-29-12-2",
    "zhHans": "桌上有一个棋盘。",
    "audio": "audio/601fcd2f83e511ec.m4a"
  },
  {
    "id": "additional-2026-10-29-12-3",
    "zhHans": "前面有敌人！",
    "audio": "audio/cd671ca195629be7.m4a"
  },
  {
    "id": "additional-2026-10-29-12-4",
    "zhHans": "这里没有人帮我！",
    "audio": "audio/bdf89f6a81c7603c.m4a"
  },
  {
    "id": "additional-2026-10-29-12-5",
    "zhHans": "你身边没有人了。",
    "audio": "audio/7c326aa62ea382e4.m4a"
  },
  {
    "id": "additional-2026-10-29-12-6",
    "zhHans": "这里有陷阱吗？",
    "audio": "audio/04b67fc60fe4be8e.m4a"
  },
  {
    "id": "additional-2026-10-29-12-7",
    "zhHans": "桌上有水吗？",
    "audio": "audio/30e6b33be525c97e.m4a"
  },
  {
    "id": "additional-2026-10-29-13-1",
    "zhHans": "国王在哪里？",
    "audio": "audio/d853a292148af531.m4a"
  },
  {
    "id": "additional-2026-10-29-13-2",
    "zhHans": "王后不在这里了！",
    "audio": "audio/7248a760a16375c2.m4a"
  },
  {
    "id": "additional-2026-10-29-13-3",
    "zhHans": "敌人在后面！",
    "audio": "audio/7f3bd6f21d3bcab8.m4a"
  },
  {
    "id": "additional-2026-10-29-13-4",
    "zhHans": "我在家。",
    "audio": "audio/b02ea643cd2be4d0.m4a"
  },
  {
    "id": "additional-2026-10-29-13-5",
    "zhHans": "你的朋友不在这儿。",
    "audio": "audio/ba7970fa1acfb70d.m4a"
  },
  {
    "id": "additional-2026-10-29-13-6",
    "zhHans": "我的朋友都不在了。",
    "audio": "audio/7dbf80e5bf899b99.m4a"
  },
  {
    "id": "additional-2026-10-29-14-1",
    "zhHans": "看后面！",
    "audio": "audio/d05a877ecc18ee57.m4a"
  },
  {
    "id": "additional-2026-10-29-14-2",
    "zhHans": "看前面！",
    "audio": "audio/92c91e239bbbcdc8.m4a"
  },
  {
    "id": "additional-2026-10-29-14-3",
    "zhHans": "看左边！",
    "audio": "audio/aa97ec6b638a56de.m4a"
  },
  {
    "id": "additional-2026-10-29-14-4",
    "zhHans": "看右边！",
    "audio": "audio/68f2b57da4757ec0.m4a"
  },
  {
    "id": "additional-2026-10-29-14-5",
    "zhHans": "他在我旁边！",
    "audio": "audio/79108f764e02824d.m4a"
  },
  {
    "id": "additional-2026-10-29-14-6",
    "zhHans": "危险在上面！",
    "audio": "audio/beca9dbdbe5e0dc3.m4a"
  },
  {
    "id": "additional-2026-10-29-14-7",
    "zhHans": "下面也有敌人！",
    "audio": "audio/470a10672aca4137.m4a"
  },
  {
    "id": "additional-2026-10-29-14-8",
    "zhHans": "我的兵在哪里？",
    "audio": "audio/7f333f81c5f747ec.m4a"
  },
  {
    "id": "additional-2026-10-29-14-9",
    "zhHans": "棋盘上有什么？",
    "audio": "audio/870bda65a66157b9.m4a"
  },
  {
    "id": "additional-2026-10-29-14-10",
    "zhHans": "城堡里只有你。",
    "audio": "audio/10bfb10c312222f5.m4a"
  },
  {
    "id": "additional-2026-10-29-14-11",
    "zhHans": "房间里只有我。",
    "audio": "audio/c601ec3bf7b4d39f.m4a"
  },
  {
    "id": "additional-2026-10-29-14-12",
    "zhHans": "门外有人！",
    "audio": "audio/1698c6bc2fabdea6.m4a"
  },
  {
    "id": "additional-2026-10-29-14-13",
    "zhHans": "敌人在门口！",
    "audio": "audio/702360cb63094498.m4a"
  },
  {
    "id": "additional-2026-10-29-14-14",
    "zhHans": "国王在城堡里。",
    "audio": "audio/5a647cda636dfe81.m4a"
  },
  {
    "id": "additional-2026-10-29-15-1",
    "zhHans": "别来这儿！",
    "audio": "audio/8244b3e616da1fce.m4a"
  },
  {
    "id": "additional-2026-10-29-15-2",
    "zhHans": "快来这儿！",
    "audio": "audio/6f1ba6e52ced77fb.m4a"
  },
  {
    "id": "additional-2026-10-29-15-3",
    "zhHans": "别去那儿！",
    "audio": "audio/444268f182762f7b.m4a"
  },
  {
    "id": "additional-2026-10-29-15-4",
    "zhHans": "你怎么到那儿去了？",
    "audio": "audio/d4a6572be271fcbc.m4a"
  },
  {
    "id": "additional-2026-10-29-15-5",
    "zhHans": "这里安全吗？",
    "audio": "audio/123b0fed0913fcdd.m4a"
  },
  {
    "id": "additional-2026-10-29-15-6",
    "zhHans": "这里很危险！",
    "audio": "audio/ba1c7bb34c146ea5.m4a"
  },
  {
    "id": "additional-2026-10-29-15-7",
    "zhHans": "那里有什么？",
    "audio": "audio/ae84da6b0f618d91.m4a"
  },
  {
    "id": "additional-2026-10-29-15-8",
    "zhHans": "那里不安全！",
    "audio": "audio/7b037da0aa6a4a6b.m4a"
  },
  {
    "id": "additional-2026-10-29-15-9",
    "zhHans": "你要去哪里？",
    "audio": "audio/53d8a8d94fdd6f82.m4a"
  },
  {
    "id": "additional-2026-10-29-15-10",
    "zhHans": "我该去哪里？",
    "audio": "audio/962dd23c066f69b2.m4a"
  },
  {
    "id": "additional-2026-10-29-15-11",
    "zhHans": "你那儿有棋盘吗？",
    "audio": "audio/e29d1b505f32b20d.m4a"
  },
  {
    "id": "additional-2026-10-29-15-12",
    "zhHans": "我这儿有水。",
    "audio": "audio/82d06796ae922a07.m4a"
  },
  {
    "id": "additional-2026-10-29-15-13",
    "zhHans": "你朋友那儿还有人吗？",
    "audio": "audio/50b4507a9df2adb7.m4a"
  },
  {
    "id": "additional-2026-10-29-16-1",
    "zhHans": "你非常聪明！",
    "audio": "audio/dfaedee522478c23.m4a"
  },
  {
    "id": "additional-2026-10-29-16-2",
    "zhHans": "你非常厉害！",
    "audio": "audio/3f305a7117712432.m4a"
  },
  {
    "id": "additional-2026-10-29-16-3",
    "zhHans": "今天比较热。",
    "audio": "audio/c612ca8fcfcb9e22.m4a"
  },
  {
    "id": "additional-2026-10-29-16-4",
    "zhHans": "这局比较难。",
    "audio": "audio/0cb8449d7e22b124.m4a"
  },
  {
    "id": "additional-2026-10-29-16-5",
    "zhHans": "我有点儿紧张。",
    "audio": "audio/1c88b9b04e4586a4.m4a"
  },
  {
    "id": "additional-2026-10-29-16-6",
    "zhHans": "我有点儿害怕。",
    "audio": "audio/6dcecc959dd44678.m4a"
  },
  {
    "id": "additional-2026-10-29-16-7",
    "zhHans": "我有点儿累了。",
    "audio": "audio/f0dc9442d9078b2f.m4a"
  },
  {
    "id": "additional-2026-10-29-17-1",
    "zhHans": "我不开心。",
    "audio": "audio/22fce0e227eb24e4.m4a"
  },
  {
    "id": "additional-2026-10-29-17-2",
    "zhHans": "我不害怕！",
    "audio": "audio/46bf377e92767720.m4a"
  },
  {
    "id": "additional-2026-10-29-17-3",
    "zhHans": "我不很高兴。",
    "audio": "audio/5ab29520ed848f08.m4a"
  },
  {
    "id": "additional-2026-10-29-17-4",
    "zhHans": "我很不高兴！",
    "audio": "audio/a8b0787c2888de18.m4a"
  },
  {
    "id": "additional-2026-10-29-17-5",
    "zhHans": "今天不很冷。",
    "audio": "audio/67cece60d5ecc1a9.m4a"
  },
  {
    "id": "additional-2026-10-29-17-6",
    "zhHans": "你太快了！",
    "audio": "audio/51966b0d126e06c4.m4a"
  },
  {
    "id": "additional-2026-10-29-17-7",
    "zhHans": "这太危险了！",
    "audio": "audio/05e344679a714ff4.m4a"
  },
  {
    "id": "additional-2026-10-29-18-1",
    "zhHans": "你忙不忙？",
    "audio": "audio/88dc9964f0216dcb.m4a"
  },
  {
    "id": "additional-2026-10-29-18-2",
    "zhHans": "你紧张不紧张？",
    "audio": "audio/6589d10776462550.m4a"
  },
  {
    "id": "additional-2026-10-29-18-3",
    "zhHans": "你累不累？",
    "audio": "audio/0e995d2b39d123ae.m4a"
  },
  {
    "id": "additional-2026-10-29-18-4",
    "zhHans": "这一步难不难？",
    "audio": "audio/f26c14c19331837a.m4a"
  },
  {
    "id": "additional-2026-10-29-18-5",
    "zhHans": "这局有多难？",
    "audio": "audio/05596efd655cb7ab.m4a"
  },
  {
    "id": "additional-2026-10-29-18-6",
    "zhHans": "你觉得这局怎么样？",
    "audio": "audio/29bb658caefae0b0.m4a"
  },
  {
    "id": "additional-2026-10-29-19-1",
    "zhHans": "这是一个很好的办法。",
    "audio": "audio/b87dd6c094bf95cc.m4a"
  },
  {
    "id": "additional-2026-10-29-19-2",
    "zhHans": "你是一个很强的对手。",
    "audio": "audio/a35c88a820e7d281.m4a"
  },
  {
    "id": "additional-2026-10-29-19-3",
    "zhHans": "今天是非常重要的一天。",
    "audio": "audio/0b2ab6fb76349acf.m4a"
  },
  {
    "id": "additional-2026-10-29-19-4",
    "zhHans": "这是一个非常好的主意！",
    "audio": "audio/0b3c3a805b36fc4a.m4a"
  },
  {
    "id": "additional-2026-10-29-19-5",
    "zhHans": "这是一场挺有意思的比赛。",
    "audio": "audio/849125db994b4fce.m4a"
  },
  {
    "id": "additional-2026-10-29-20-1",
    "zhHans": "我想喝热热的茶。",
    "audio": "audio/ef045d5f9ea590be.m4a"
  },
  {
    "id": "additional-2026-10-29-20-2",
    "zhHans": "我的小小的梦想破灭了。",
    "audio": "audio/bdc24efa9b058c45.m4a"
  },
  {
    "id": "additional-2026-10-29-21-1",
    "zhHans": "这是你想的办法吗？",
    "audio": "audio/ad85aa4f27be8d50.m4a"
  },
  {
    "id": "additional-2026-10-29-21-2",
    "zhHans": "这是我写的书。",
    "audio": "audio/ec30a938004682d3.m4a"
  },
  {
    "id": "additional-2026-10-29-22-1",
    "zhHans": "我有很多问题！",
    "audio": "audio/6f97187f9bbc7e74.m4a"
  },
  {
    "id": "additional-2026-10-29-22-2",
    "zhHans": "你有不少好办法！",
    "audio": "audio/3cdacfbc5974680e.m4a"
  },
  {
    "id": "additional-2026-10-29-22-3",
    "zhHans": "今天学了很多东西。",
    "audio": "audio/8ad983a32bc7bdb1.m4a"
  },
  {
    "id": "additional-2026-10-29-22-4",
    "zhHans": "我还有很多要学的东西。",
    "audio": "audio/328f66fe2e7319bf.m4a"
  },
  {
    "id": "additional-2026-10-29-23-1",
    "zhHans": "这局不很难。",
    "audio": "audio/dd04264fb5e297f6.m4a"
  },
  {
    "id": "translated-1-1",
    "zhHans": "他被关进监狱了。",
    "audio": "audio/5a7a571fe2a50b69.m4a"
  },
  {
    "id": "translated-1-2",
    "zhHans": "我在打扫房间。",
    "audio": "audio/d162903019bfd7c5.m4a"
  },
  {
    "id": "translated-1-3",
    "zhHans": "我在收拾桌上的东西。",
    "audio": "audio/be444e0026f47ffe.m4a"
  },
  {
    "id": "translated-2-1",
    "zhHans": "可惜，兵消失了。",
    "audio": "audio/63c88a5b1d58909e.m4a"
  },
  {
    "id": "translated-2-2",
    "zhHans": "那可是我喜欢的兵！",
    "audio": "audio/02f8c72c6fe2677a.m4a"
  },
  {
    "id": "translated-2-3",
    "zhHans": "他们只是我的手和脚。",
    "audio": "audio/ac3b5bc04c7e4385.m4a"
  },
  {
    "id": "translated-3-1",
    "zhHans": "再见了。",
    "audio": "audio/14b038750e535ebf.m4a"
  },
  {
    "id": "translated-4-1",
    "zhHans": "我那匹可爱的马啊！",
    "audio": "audio/c6589147886d7169.m4a"
  },
  {
    "id": "translated-4-2",
    "zhHans": "我刚买了它！",
    "audio": "audio/d8e4315f9ca85e3a.m4a"
  },
  {
    "id": "translated-5-1",
    "zhHans": "呼，热起来了！",
    "audio": "audio/0d9f0b04f846b397.m4a"
  },
  {
    "id": "translated-6-1",
    "zhHans": "再见了。",
    "audio": "audio/14b038750e535ebf.m4a"
  },
  {
    "id": "translated-7-1",
    "zhHans": "你累了吗？",
    "audio": "audio/cc75ff8e44c776f7.m4a"
  },
  {
    "id": "translated-7-2",
    "zhHans": "再见了。",
    "audio": "audio/14b038750e535ebf.m4a"
  },
  {
    "id": "translated-7-3",
    "zhHans": "我攻下了移动的城堡！",
    "audio": "audio/71224197f4fba8ac.m4a"
  },
  {
    "id": "translated-7-4",
    "zhHans": "你的车？我给你洗！",
    "audio": "audio/0723d94f5d6cac55.m4a"
  },
  {
    "id": "translated-8-1",
    "zhHans": "喝杯咖啡，冷静一下。",
    "audio": "audio/522bf94c07407565.m4a"
  },
  {
    "id": "translated-8-2",
    "zhHans": "喝点水，冷静一下。",
    "audio": "audio/183fc308ee91c146.m4a"
  },
  {
    "id": "translated-9-1",
    "zhHans": "别生气啊！",
    "audio": "audio/56351e7431643694.m4a"
  },
  {
    "id": "translated-9-2",
    "zhHans": "再见了。",
    "audio": "audio/14b038750e535ebf.m4a"
  },
  {
    "id": "translated-9-3",
    "zhHans": "怎么了？脸都白了！",
    "audio": "audio/1996c624db01e4ff.m4a"
  },
  {
    "id": "translated-9-4",
    "zhHans": "我胸口很疼。",
    "audio": "audio/2819a968b1ddf4ad.m4a"
  },
  {
    "id": "translated-9-5",
    "zhHans": "王后……死了……",
    "audio": "audio/f9c677575a6a1b8d.m4a"
  },
  {
    "id": "translated-10-1",
    "zhHans": "我想回家了。",
    "audio": "audio/599b6259533f51ae.m4a"
  },
  {
    "id": "translated-10-2",
    "zhHans": "我快哭了。",
    "audio": "audio/e3b66dd3aefdd715.m4a"
  },
  {
    "id": "translated-10-3",
    "zhHans": "啊，头好疼。",
    "audio": "audio/6759c042a2138957.m4a"
  },
  {
    "id": "translated-10-4",
    "zhHans": "王后……死了……",
    "audio": "audio/f9c677575a6a1b8d.m4a"
  },
  {
    "id": "translated-10-5",
    "zhHans": "你有一颗冰冷的心！",
    "audio": "audio/c74b6b0c680d8b09.m4a"
  },
  {
    "id": "translated-11-1",
    "zhHans": "这局真好玩！",
    "audio": "audio/d06e57083559706b.m4a"
  },
  {
    "id": "translated-12-1",
    "zhHans": "你是白方。",
    "audio": "audio/b0f1d31d05997e9d.m4a"
  },
  {
    "id": "translated-12-2",
    "zhHans": "我是黑方。",
    "audio": "audio/65af7c80959c3c43.m4a"
  },
  {
    "id": "translated-13-1",
    "zhHans": "你是黑方。",
    "audio": "audio/c5be8dfcaf7d7a0f.m4a"
  },
  {
    "id": "translated-13-2",
    "zhHans": "我是白方。",
    "audio": "audio/cbe69edc33049057.m4a"
  },
  {
    "id": "translated-14-1",
    "zhHans": "听说国际象棋起源于印度。",
    "audio": "audio/23a22cf3ba5c7227.m4a"
  },
  {
    "id": "translated-14-2",
    "zhHans": "我们下棋吧！",
    "audio": "audio/30cf5e64ec562e09.m4a"
  },
  {
    "id": "translated-14-3",
    "zhHans": "你是白方。",
    "audio": "audio/b0f1d31d05997e9d.m4a"
  },
  {
    "id": "translated-14-4",
    "zhHans": "你是黑方。",
    "audio": "audio/c5be8dfcaf7d7a0f.m4a"
  },
  {
    "id": "translated-14-5",
    "zhHans": "我是白方。",
    "audio": "audio/cbe69edc33049057.m4a"
  },
  {
    "id": "translated-14-6",
    "zhHans": "我是黑方。",
    "audio": "audio/65af7c80959c3c43.m4a"
  },
  {
    "id": "translated-14-7",
    "zhHans": "你怕输吗？",
    "audio": "audio/c5137acbab1e1dc0.m4a"
  },
  {
    "id": "translated-14-8",
    "zhHans": "我一定会赢！",
    "audio": "audio/4ed6f1612d50f629.m4a"
  },
  {
    "id": "translated-14-9",
    "zhHans": "欢迎来到国际象棋学校！",
    "audio": "audio/259fc5abf2ba846f.m4a"
  },
  {
    "id": "translated-14-10",
    "zhHans": "我们开始吧！",
    "audio": "audio/825e7f4012ac5f23.m4a"
  },
  {
    "id": "translated-14-11",
    "zhHans": "我是老师，你是学生。",
    "audio": "audio/1edad19955c51dac.m4a"
  },
  {
    "id": "translated-15-1",
    "zhHans": "我去找国王了！",
    "audio": "audio/e2fece5ddb6d099f.m4a"
  },
  {
    "id": "translated-15-2",
    "zhHans": "你逃不掉了！",
    "audio": "audio/9ed949b1299c4391.m4a"
  },
  {
    "id": "translated-15-3",
    "zhHans": "小心背后！",
    "audio": "audio/1e60f6b2d7f8285b.m4a"
  },
  {
    "id": "translated-16-1",
    "zhHans": "陛下要过来了！让路！",
    "audio": "audio/81c897fcad0c25b9.m4a"
  },
  {
    "id": "translated-16-2",
    "zhHans": "别过来！",
    "audio": "audio/3ec00379c4231326.m4a"
  },
  {
    "id": "translated-16-3",
    "zhHans": "这是叛乱！",
    "audio": "audio/9d28f21f9752b527.m4a"
  },
  {
    "id": "translated-17-1",
    "zhHans": "赢了，开心吗？太好了！",
    "audio": "audio/3b1790385485ad68.m4a"
  },
  {
    "id": "translated-17-2",
    "zhHans": "国破山河在。",
    "audio": "audio/425658fde1cd3170.m4a"
  },
  {
    "id": "translated-17-3",
    "zhHans": "我讨厌输。",
    "audio": "audio/f172cfaba832ae21.m4a"
  },
  {
    "id": "translated-17-4",
    "zhHans": "你比我强！",
    "audio": "audio/5e4a1df9bb8a569e.m4a"
  },
  {
    "id": "translated-17-5",
    "zhHans": "别告诉我妈妈！",
    "audio": "audio/5391f5bb1d71558c.m4a"
  },
  {
    "id": "translated-17-6",
    "zhHans": "别告诉我爸爸！",
    "audio": "audio/f99a0e53bd6481e0.m4a"
  },
  {
    "id": "translated-17-7",
    "zhHans": "明天我会赢！",
    "audio": "audio/9fab434a0696a35e.m4a"
  },
  {
    "id": "translated-18-1",
    "zhHans": "借你一本棋书？",
    "audio": "audio/2c45c04ae042eefb.m4a"
  },
  {
    "id": "translated-18-2",
    "zhHans": "比赛结束了。",
    "audio": "audio/afdc2e6e8a8c8d73.m4a"
  },
  {
    "id": "translated-18-3",
    "zhHans": "弱一点也没关系。",
    "audio": "audio/697f7c2cc119d53b.m4a"
  },
  {
    "id": "translated-18-4",
    "zhHans": "不甘心吗？",
    "audio": "audio/29ffdcdb54e9409d.m4a"
  },
  {
    "id": "translated-18-5",
    "zhHans": "真该录个视频！",
    "audio": "audio/a722d1c941a1ea6f.m4a"
  },
  {
    "id": "translated-18-6",
    "zhHans": "明天再下吧！",
    "audio": "audio/ae3200c50db3784a.m4a"
  },
  {
    "id": "translated-19-1",
    "zhHans": "你看到了吗？",
    "audio": "audio/b2c1b9735a59b9a0.m4a"
  },
  {
    "id": "translated-19-2",
    "zhHans": "王侯将相，宁有种乎！",
    "audio": "audio/26a28e87090fd8bb.m4a"
  },
  {
    "id": "translated-20-1",
    "zhHans": "〇〇出现了！",
    "audio": "audio/f58cca9ac2573a4d.m4a"
  },
  {
    "id": "translated-20-2",
    "zhHans": "王后回来了！",
    "audio": "audio/13f931a17238973e.m4a"
  },
  {
    "id": "translated-21-1",
    "zhHans": "我不会放弃！",
    "audio": "audio/588bf1ff7bbdcfa0.m4a"
  },
  {
    "id": "translated-21-2",
    "zhHans": "救命！",
    "audio": "audio/36d74b0596dd5453.m4a"
  },
  {
    "id": "translated-21-3",
    "zhHans": "借我手机！我要打电话求救！",
    "audio": "audio/c728f2f53cd38c43.m4a"
  },
  {
    "id": "translated-22-1",
    "zhHans": "只剩你一个了。",
    "audio": "audio/447ae89f0ba62ad5.m4a"
  },
  {
    "id": "translated-22-2",
    "zhHans": "寂寞吗？",
    "audio": "audio/6ebc5a19d3e41e74.m4a"
  },
  {
    "id": "translated-22-3",
    "zhHans": "陛下，您寂寞吗？",
    "audio": "audio/5c875953ac57579e.m4a"
  },
  {
    "id": "translated-23-1",
    "zhHans": "早上好！",
    "audio": "audio/923b4bcc9ca958f0.m4a"
  },
  {
    "id": "translated-23-2",
    "zhHans": "你起得真早！",
    "audio": "audio/0c7865712df2f995.m4a"
  },
  {
    "id": "translated-23-3",
    "zhHans": "外面很亮。",
    "audio": "audio/6714208e72d1de7e.m4a"
  },
  {
    "id": "translated-24-1",
    "zhHans": "晚上好！",
    "audio": "audio/432453e4bbbbbaa2.m4a"
  },
  {
    "id": "translated-24-2",
    "zhHans": "现在？你不困吗？",
    "audio": "audio/fd55f37a13583e17.m4a"
  },
  {
    "id": "translated-24-3",
    "zhHans": "你睡得真晚！",
    "audio": "audio/a178ea03e40cdc2b.m4a"
  },
  {
    "id": "translated-24-4",
    "zhHans": "外面已经黑了。",
    "audio": "audio/5a6a6576383414b3.m4a"
  },
  {
    "id": "translated-24-5",
    "zhHans": "现在几点了？",
    "audio": "audio/b1006637795d20c3.m4a"
  },
  {
    "id": "translated-25-1",
    "zhHans": "陛下进城堡了！",
    "audio": "audio/6fbc074ca1585eef.m4a"
  },
  {
    "id": "translated-26-1",
    "zhHans": "陛下，请出来！",
    "audio": "audio/d2c723f9c1a8e735.m4a"
  },
  {
    "id": "translated-27-1",
    "zhHans": "又见面了！",
    "audio": "audio/ced59db1b3efc616.m4a"
  },
  {
    "id": "translated-27-2",
    "zhHans": "今天都见你好几次了！",
    "audio": "audio/0bee038dc1970ee9.m4a"
  },
  {
    "id": "translated-28-1",
    "zhHans": "真快！",
    "audio": "audio/a3db86615223e984.m4a"
  },
  {
    "id": "translated-28-2",
    "zhHans": "太快了！",
    "audio": "audio/57b8afa20c06b0cb.m4a"
  },
  {
    "id": "translated-29-1",
    "zhHans": "形势逆转了！",
    "audio": "audio/897e730fb4930935.m4a"
  },
  {
    "id": "translated-30-1",
    "zhHans": "求你了，等一下！",
    "audio": "audio/d16a6e5ee980999b.m4a"
  },
  {
    "id": "translated-31-1",
    "zhHans": "小时候，爷爷教过我。",
    "audio": "audio/8e635e5705a995a5.m4a"
  },
  {
    "id": "translated-31-2",
    "zhHans": "小时候，奶奶教过我。",
    "audio": "audio/3baaa79cf78ab38d.m4a"
  }
]