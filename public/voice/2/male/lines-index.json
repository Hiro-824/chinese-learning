[
  {
    "id": "additional-2026-10-29-1-1",
    "zhHans": "我不喜欢输。",
    "audio": "audio/f5f3cd66c3a11560.m4a"
  },
  {
    "id": "additional-2026-10-29-1-2",
    "zhHans": "我不走！",
    "audio": "audio/ad9f275aa2d8bd46.m4a"
  },
  {
    "id": "additional-2026-10-29-1-3",
    "zhHans": "你也喜欢下棋吗？",
    "audio": "audio/27430ca1014304bc.m4a"
  },
  {
    "id": "additional-2026-10-29-1-4",
    "zhHans": "我也来了！",
    "audio": "audio/b1c10f0fb2065ad9.m4a"
  },
  {
    "id": "additional-2026-10-29-1-5",
    "zhHans": "我们都准备好了。",
    "audio": "audio/1ccf879701d32380.m4a"
  },
  {
    "id": "additional-2026-10-29-2-1",
    "zhHans": "咱们开始吧！",
    "audio": "audio/d7f480d959032155.m4a"
  },
  {
    "id": "additional-2026-10-29-2-2",
    "zhHans": "咱们再来一局！",
    "audio": "audio/4931b85f5dd59dda.m4a"
  },
  {
    "id": "additional-2026-10-29-2-3",
    "zhHans": "咱们明天再玩吧！",
    "audio": "audio/7c4b4a51003025dc.m4a"
  },
  {
    "id": "additional-2026-10-29-2-4",
    "zhHans": "你们准备好了吗？",
    "audio": "audio/5bf8d603d803f5be.m4a"
  },
  {
    "id": "additional-2026-10-29-2-5",
    "zhHans": "你们真厉害！",
    "audio": "audio/a090f84b411f553c.m4a"
  },
  {
    "id": "additional-2026-10-29-2-6",
    "zhHans": "你们起得真早！",
    "audio": "audio/989f73be35e3b307.m4a"
  },
  {
    "id": "additional-2026-10-29-2-7",
    "zhHans": "大家准备好了吗？",
    "audio": "audio/35f1212f739dbec9.m4a"
  },
  {
    "id": "additional-2026-10-29-2-8",
    "zhHans": "大家都笑我！",
    "audio": "audio/d4925b17d5300e80.m4a"
  },
  {
    "id": "additional-2026-10-29-3-1",
    "zhHans": "她是我的朋友。",
    "audio": "audio/cf91b67e0491849b.m4a"
  },
  {
    "id": "additional-2026-10-29-3-2",
    "zhHans": "她跑得真快！",
    "audio": "audio/293ff0ed6b2bf73e.m4a"
  },
  {
    "id": "additional-2026-10-29-3-3",
    "zhHans": "她回来了！",
    "audio": "audio/af3c8472a4171a52.m4a"
  },
  {
    "id": "additional-2026-10-29-3-4",
    "zhHans": "她们都走了。",
    "audio": "audio/ffda7840ef9af802.m4a"
  },
  {
    "id": "additional-2026-10-29-3-5",
    "zhHans": "他们都走了。",
    "audio": "audio/fe0f949b10bacab3.m4a"
  },
  {
    "id": "additional-2026-10-29-3-6",
    "zhHans": "他们不在这里。",
    "audio": "audio/d83b3caf04e0c48f.m4a"
  },
  {
    "id": "additional-2026-10-29-4-1",
    "zhHans": "它不见了！",
    "audio": "audio/a045c7664a3558b9.m4a"
  },
  {
    "id": "additional-2026-10-29-4-2",
    "zhHans": "它去哪儿了？",
    "audio": "audio/80611e808a295e1d.m4a"
  },
  {
    "id": "additional-2026-10-29-4-3",
    "zhHans": "它变了！",
    "audio": "audio/c94d76a9af993e84.m4a"
  },
  {
    "id": "additional-2026-10-29-4-4",
    "zhHans": "它们去哪儿了？",
    "audio": "audio/ae729c29c3e8360a.m4a"
  },
  {
    "id": "additional-2026-10-29-4-5",
    "zhHans": "我自己来！",
    "audio": "audio/1251d3c6a8b498eb.m4a"
  },
  {
    "id": "additional-2026-10-29-4-6",
    "zhHans": "你自己来吗？",
    "audio": "audio/8895f4ef511a1d5e.m4a"
  },
  {
    "id": "additional-2026-10-29-4-7",
    "zhHans": "别告诉别人！",
    "audio": "audio/41bec488a4fc246e.m4a"
  },
  {
    "id": "additional-2026-10-29-4-8",
    "zhHans": "人家不想输嘛！",
    "audio": "audio/d5b216b4a75eb307.m4a"
  },
  {
    "id": "additional-2026-10-29-5-1",
    "zhHans": "你不是黑方。",
    "audio": "audio/b9ee4f89eda640b6.m4a"
  },
  {
    "id": "additional-2026-10-29-5-2",
    "zhHans": "我不是黑方。",
    "audio": "audio/2c00e2e035c3bac2.m4a"
  },
  {
    "id": "additional-2026-10-29-5-3",
    "zhHans": "这不是玩笑！",
    "audio": "audio/1a07dfb654a48de9.m4a"
  },
  {
    "id": "additional-2026-10-29-5-4",
    "zhHans": "你是学生吗？",
    "audio": "audio/e0349f4c6a01e55f.m4a"
  },
  {
    "id": "additional-2026-10-29-5-5",
    "zhHans": "这是你的棋盘吗？",
    "audio": "audio/184f764283f3a453.m4a"
  },
  {
    "id": "additional-2026-10-29-5-6",
    "zhHans": "这是你的计划吗？",
    "audio": "audio/e190781893c274b3.m4a"
  },
  {
    "id": "additional-2026-10-29-5-7",
    "zhHans": "我也是学生。",
    "audio": "audio/76c3735f206f3529.m4a"
  },
  {
    "id": "additional-2026-10-29-5-8",
    "zhHans": "她也是王后！",
    "audio": "audio/94afe7a2bd5627e7.m4a"
  },
  {
    "id": "additional-2026-10-29-5-9",
    "zhHans": "我们都是学生。",
    "audio": "audio/d0618a8e2d207d83.m4a"
  },
  {
    "id": "additional-2026-10-29-5-10",
    "zhHans": "我也不是每次都赢。",
    "audio": "audio/d4897476921624d6.m4a"
  },
  {
    "id": "additional-2026-10-29-6-1",
    "zhHans": "这个很好！",
    "audio": "audio/7f7d0e72e149fe61.m4a"
  },
  {
    "id": "additional-2026-10-29-6-2",
    "zhHans": "那个更好！",
    "audio": "audio/55243f1f75e43613.m4a"
  },
  {
    "id": "additional-2026-10-29-6-3",
    "zhHans": "这个游戏真有趣！",
    "audio": "audio/eb10d107abe91c62.m4a"
  },
  {
    "id": "additional-2026-10-29-6-4",
    "zhHans": "那个办法真好！",
    "audio": "audio/97fc18ea3dc62104.m4a"
  },
  {
    "id": "additional-2026-10-29-6-5",
    "zhHans": "你喜欢哪个？",
    "audio": "audio/256cfdbfd7fd7446.m4a"
  },
  {
    "id": "additional-2026-10-29-6-6",
    "zhHans": "你要哪个？",
    "audio": "audio/278f956e80ddbaf8.m4a"
  },
  {
    "id": "additional-2026-10-29-6-7",
    "zhHans": "哪匹马不见了？",
    "audio": "audio/2c6eb29899e1fa5c.m4a"
  },
  {
    "id": "additional-2026-10-29-6-8",
    "zhHans": "这些是谁的？",
    "audio": "audio/fdb6b0b47018c6c3.m4a"
  },
  {
    "id": "additional-2026-10-29-6-9",
    "zhHans": "那些都是我的！",
    "audio": "audio/7df97152e6de4bb4.m4a"
  },
  {
    "id": "additional-2026-10-29-6-10",
    "zhHans": "这些是什么？",
    "audio": "audio/174042ab5e01ec24.m4a"
  },
  {
    "id": "additional-2026-10-29-6-11",
    "zhHans": "哪些是你的？",
    "audio": "audio/ad815ce32df2058d.m4a"
  },
  {
    "id": "additional-2026-10-29-6-12",
    "zhHans": "那些兵都去哪儿了？",
    "audio": "audio/e1f7452f11907e69.m4a"
  },
  {
    "id": "additional-2026-10-29-7-1",
    "zhHans": "这是中国的游戏吗？",
    "audio": "audio/af438cfe7fc4e02e.m4a"
  },
  {
    "id": "additional-2026-10-29-7-2",
    "zhHans": "这是我的，你的是那个。",
    "audio": "audio/01b7363a746c6f4c.m4a"
  },
  {
    "id": "additional-2026-10-29-7-3",
    "zhHans": "白色的是你的。",
    "audio": "audio/51573e2135edc155.m4a"
  },
  {
    "id": "additional-2026-10-29-7-4",
    "zhHans": "黑色的是你的。",
    "audio": "audio/7242da68ba554e2b.m4a"
  },
  {
    "id": "additional-2026-10-29-7-5",
    "zhHans": "我的老师喜欢下棋。",
    "audio": "audio/eb26cf5198c3a0da.m4a"
  },
  {
    "id": "additional-2026-10-29-7-6",
    "zhHans": "我老师会生气的！",
    "audio": "audio/089d386b62119414.m4a"
  },
  {
    "id": "additional-2026-10-29-7-7",
    "zhHans": "我们学校也有棋社。",
    "audio": "audio/a5c4e8fcc74d7267.m4a"
  },
  {
    "id": "additional-2026-10-29-7-8",
    "zhHans": "我家有棋盘。",
    "audio": "audio/9a190bb85a62a6cc.m4a"
  },
  {
    "id": "additional-2026-10-29-7-9",
    "zhHans": "这是一个重要的问题。",
    "audio": "audio/b11075ef1d62a41a.m4a"
  },
  {
    "id": "additional-2026-10-29-7-10",
    "zhHans": "这是一个好办法！",
    "audio": "audio/9288882e8464e9b3.m4a"
  },
  {
    "id": "additional-2026-10-29-8-1",
    "zhHans": "你玩不玩？",
    "audio": "audio/48f574f616e11e51.m4a"
  },
  {
    "id": "additional-2026-10-29-8-2",
    "zhHans": "你来不来？",
    "audio": "audio/38128839a4b77653.m4a"
  },
  {
    "id": "additional-2026-10-29-8-3",
    "zhHans": "你走不走？",
    "audio": "audio/fcd3354a1c650f3c.m4a"
  },
  {
    "id": "additional-2026-10-29-8-4",
    "zhHans": "你是不是学生？",
    "audio": "audio/7fccde4036a4c137.m4a"
  },
  {
    "id": "additional-2026-10-29-8-5",
    "zhHans": "这是不是将军？",
    "audio": "audio/e72617f9002d6e51.m4a"
  },
  {
    "id": "additional-2026-10-29-8-6",
    "zhHans": "这是不是陷阱？",
    "audio": "audio/98e8153deacbbbd8.m4a"
  },
  {
    "id": "additional-2026-10-29-8-7",
    "zhHans": "你想不想再玩？",
    "audio": "audio/ed3c20c007e09e05.m4a"
  },
  {
    "id": "additional-2026-10-29-8-8",
    "zhHans": "你下不下棋？",
    "audio": "audio/1e2ae06c4ac5bb60.m4a"
  },
  {
    "id": "additional-2026-10-29-8-9",
    "zhHans": "你喝不喝水？",
    "audio": "audio/e3d96d089137fbd7.m4a"
  },
  {
    "id": "additional-2026-10-29-8-10",
    "zhHans": "你下棋不下？",
    "audio": "audio/4a8dfe351fcee64a.m4a"
  },
  {
    "id": "additional-2026-10-29-8-11",
    "zhHans": "你喝水不喝？",
    "audio": "audio/9c615be44d8b27fd.m4a"
  },
  {
    "id": "additional-2026-10-29-9-1",
    "zhHans": "这是什么？",
    "audio": "audio/55233d4bacbe029f.m4a"
  },
  {
    "id": "additional-2026-10-29-9-2",
    "zhHans": "你想干什么？",
    "audio": "audio/44fb8a49b3f7aee1.m4a"
  },
  {
    "id": "additional-2026-10-29-9-3",
    "zhHans": "谁干的？",
    "audio": "audio/61d5a8ef607c241d.m4a"
  },
  {
    "id": "additional-2026-10-29-9-4",
    "zhHans": "谁教你的？",
    "audio": "audio/22105e55a8845092.m4a"
  },
  {
    "id": "additional-2026-10-29-9-5",
    "zhHans": "你的朋友在哪儿？",
    "audio": "audio/0754a158b44329f2.m4a"
  },
  {
    "id": "additional-2026-10-29-9-6",
    "zhHans": "我的朋友去哪儿了？",
    "audio": "audio/ca51f9e7bb4586eb.m4a"
  },
  {
    "id": "additional-2026-10-29-9-7",
    "zhHans": "你什么时候回家？",
    "audio": "audio/8abdd123b882e186.m4a"
  },
  {
    "id": "additional-2026-10-29-9-8",
    "zhHans": "你什么时候学的棋？",
    "audio": "audio/e495a29eb6e0318c.m4a"
  },
  {
    "id": "additional-2026-10-29-9-9",
    "zhHans": "为什么是她？",
    "audio": "audio/34847c02c6b47f8b.m4a"
  },
  {
    "id": "additional-2026-10-29-9-10",
    "zhHans": "为什么走这一步？",
    "audio": "audio/0a7a827090a91783.m4a"
  },
  {
    "id": "additional-2026-10-29-9-11",
    "zhHans": "今天怎么样？",
    "audio": "audio/e1ae8d4962819dc2.m4a"
  },
  {
    "id": "additional-2026-10-29-9-12",
    "zhHans": "这局怎么样？",
    "audio": "audio/766f67ddc3fec5d8.m4a"
  },
  {
    "id": "additional-2026-10-29-9-13",
    "zhHans": "你觉得怎么样？",
    "audio": "audio/9aba4a892cde523a.m4a"
  },
  {
    "id": "additional-2026-10-29-10-1",
    "zhHans": "你有好办法！",
    "audio": "audio/44dff8041df96410.m4a"
  },
  {
    "id": "additional-2026-10-29-10-2",
    "zhHans": "你有兄弟姐妹吗？",
    "audio": "audio/47906c1f52b76fad.m4a"
  },
  {
    "id": "additional-2026-10-29-10-3",
    "zhHans": "你没有朋友了吗？",
    "audio": "audio/790d9de55812391e.m4a"
  },
  {
    "id": "additional-2026-10-29-10-4",
    "zhHans": "我没有办法了！",
    "audio": "audio/b099a66bb17195e1.m4a"
  },
  {
    "id": "additional-2026-10-29-10-5",
    "zhHans": "你有没有秘密？",
    "audio": "audio/0db8929b25ccdcd1.m4a"
  },
  {
    "id": "additional-2026-10-29-10-6",
    "zhHans": "你有没有棋盘？",
    "audio": "audio/122ea0b73c3355f7.m4a"
  },
  {
    "id": "additional-2026-10-29-10-7",
    "zhHans": "你有没有办法？",
    "audio": "audio/3f0f6790124ddd99.m4a"
  },
  {
    "id": "additional-2026-10-29-10-8",
    "zhHans": "你有计划没有？",
    "audio": "audio/4217e9c9f6a776b6.m4a"
  },
  {
    "id": "additional-2026-10-29-11-1",
    "zhHans": "这一步真好！",
    "audio": "audio/e7068fc80716c279.m4a"
  },
  {
    "id": "additional-2026-10-29-11-2",
    "zhHans": "再来一局！",
    "audio": "audio/c8460b6357e5aeed.m4a"
  },
  {
    "id": "additional-2026-10-29-11-3",
    "zhHans": "我带了一本书。",
    "audio": "audio/edb8e3528407df96.m4a"
  },
  {
    "id": "additional-2026-10-29-11-4",
    "zhHans": "我给你一张照片。",
    "audio": "audio/e01a4c10ed2b8979.m4a"
  },
  {
    "id": "additional-2026-10-29-11-5",
    "zhHans": "我要一把椅子。",
    "audio": "audio/b61b4c061cef2006.m4a"
  },
  {
    "id": "additional-2026-10-29-11-6",
    "zhHans": "我想吃一条鱼。",
    "audio": "audio/34a903f98a08ea19.m4a"
  },
  {
    "id": "additional-2026-10-29-11-7",
    "zhHans": "给我一枝笔。",
    "audio": "audio/b90fcc910d87ea72.m4a"
  },
  {
    "id": "additional-2026-10-29-11-8",
    "zhHans": "我想吃一块蛋糕。",
    "audio": "audio/31d38306dfb21375.m4a"
  },
  {
    "id": "additional-2026-10-29-11-9",
    "zhHans": "我坐那辆车回家。",
    "audio": "audio/9caddcf3b6b5a0aa.m4a"
  },
  {
    "id": "additional-2026-10-29-11-10",
    "zhHans": "我的两只眼睛都哭红了！",
    "audio": "audio/894cabff62caf4a9.m4a"
  },
  {
    "id": "additional-2026-10-29-11-11",
    "zhHans": "我想买一双新鞋。",
    "audio": "audio/2ec6fb9d0e131155.m4a"
  },
  {
    "id": "additional-2026-10-29-11-12",
    "zhHans": "我穿了一件新衣服。",
    "audio": "audio/113768097ed0bdb5.m4a"
  },
  {
    "id": "additional-2026-10-29-11-13",
    "zhHans": "我写了一封信。",
    "audio": "audio/97f2063fb863fa55.m4a"
  },
  {
    "id": "additional-2026-10-29-11-14",
    "zhHans": "我坐飞机来的。",
    "audio": "audio/44714ac0704ed328.m4a"
  },
  {
    "id": "additional-2026-10-29-11-15",
    "zhHans": "我看见一架飞机！",
    "audio": "audio/a87a087f0e32d35d.m4a"
  },
  {
    "id": "additional-2026-10-29-11-16",
    "zhHans": "我想吃一碗面条。",
    "audio": "audio/e46b8e66624fb824.m4a"
  },
  {
    "id": "additional-2026-10-29-11-17",
    "zhHans": "喝一杯水吧！",
    "audio": "audio/2855d44f36273d45.m4a"
  },
  {
    "id": "additional-2026-10-29-12-1",
    "zhHans": "这里有一个陷阱！",
    "audio": "audio/26ce321e33390648.m4a"
  },
  {
    "id": "additional-2026-10-29-12-2",
    "zhHans": "桌上有一个棋盘。",
    "audio": "audio/22c557ff77269b7c.m4a"
  },
  {
    "id": "additional-2026-10-29-12-3",
    "zhHans": "前面有敌人！",
    "audio": "audio/50929901e0c4fcd0.m4a"
  },
  {
    "id": "additional-2026-10-29-12-4",
    "zhHans": "这里没有人帮我！",
    "audio": "audio/ab0e42754408cc11.m4a"
  },
  {
    "id": "additional-2026-10-29-12-5",
    "zhHans": "你身边没有人了。",
    "audio": "audio/d88bc8f096df49a7.m4a"
  },
  {
    "id": "additional-2026-10-29-12-6",
    "zhHans": "这里有陷阱吗？",
    "audio": "audio/8d9b6f3eeb4d6678.m4a"
  },
  {
    "id": "additional-2026-10-29-12-7",
    "zhHans": "桌上有水吗？",
    "audio": "audio/881e3c0fbf6e8e86.m4a"
  },
  {
    "id": "additional-2026-10-29-13-1",
    "zhHans": "国王在哪里？",
    "audio": "audio/1d2c18d11f737f2f.m4a"
  },
  {
    "id": "additional-2026-10-29-13-2",
    "zhHans": "王后不在这里了！",
    "audio": "audio/23ee02b04f569ab7.m4a"
  },
  {
    "id": "additional-2026-10-29-13-3",
    "zhHans": "敌人在后面！",
    "audio": "audio/1e5e09c6c0eb4711.m4a"
  },
  {
    "id": "additional-2026-10-29-13-4",
    "zhHans": "我在家。",
    "audio": "audio/28da49b1ff4eea46.m4a"
  },
  {
    "id": "additional-2026-10-29-13-5",
    "zhHans": "你的朋友不在这儿。",
    "audio": "audio/cad8b09acd74f447.m4a"
  },
  {
    "id": "additional-2026-10-29-13-6",
    "zhHans": "我的朋友都不在了。",
    "audio": "audio/36e990adde84b19a.m4a"
  },
  {
    "id": "additional-2026-10-29-14-1",
    "zhHans": "看后面！",
    "audio": "audio/1b139969225066b8.m4a"
  },
  {
    "id": "additional-2026-10-29-14-2",
    "zhHans": "看前面！",
    "audio": "audio/11259435b7e16d44.m4a"
  },
  {
    "id": "additional-2026-10-29-14-3",
    "zhHans": "看左边！",
    "audio": "audio/6e2be468c4fcc88c.m4a"
  },
  {
    "id": "additional-2026-10-29-14-4",
    "zhHans": "看右边！",
    "audio": "audio/81c27d98e6b73212.m4a"
  },
  {
    "id": "additional-2026-10-29-14-5",
    "zhHans": "他在我旁边！",
    "audio": "audio/c8462f988042e700.m4a"
  },
  {
    "id": "additional-2026-10-29-14-6",
    "zhHans": "危险在上面！",
    "audio": "audio/83c79cd426876ab2.m4a"
  },
  {
    "id": "additional-2026-10-29-14-7",
    "zhHans": "下面也有敌人！",
    "audio": "audio/6eb28c8ca3e6c21b.m4a"
  },
  {
    "id": "additional-2026-10-29-14-8",
    "zhHans": "我的兵在哪里？",
    "audio": "audio/6f51749c7b140d4f.m4a"
  },
  {
    "id": "additional-2026-10-29-14-9",
    "zhHans": "棋盘上有什么？",
    "audio": "audio/540e0000517eec0a.m4a"
  },
  {
    "id": "additional-2026-10-29-14-10",
    "zhHans": "城堡里只有你。",
    "audio": "audio/acf690cd8a656cf2.m4a"
  },
  {
    "id": "additional-2026-10-29-14-11",
    "zhHans": "房间里只有我。",
    "audio": "audio/862bfd501d8b0b6f.m4a"
  },
  {
    "id": "additional-2026-10-29-14-12",
    "zhHans": "门外有人！",
    "audio": "audio/9b88afbc2f59f8f7.m4a"
  },
  {
    "id": "additional-2026-10-29-14-13",
    "zhHans": "敌人在门口！",
    "audio": "audio/daa0e42c83f1d04f.m4a"
  },
  {
    "id": "additional-2026-10-29-14-14",
    "zhHans": "国王在城堡里。",
    "audio": "audio/00c9166bb9fb3b90.m4a"
  },
  {
    "id": "additional-2026-10-29-15-1",
    "zhHans": "别来这儿！",
    "audio": "audio/9ebd83fb0383829e.m4a"
  },
  {
    "id": "additional-2026-10-29-15-2",
    "zhHans": "快来这儿！",
    "audio": "audio/1bfbe654e21059f1.m4a"
  },
  {
    "id": "additional-2026-10-29-15-3",
    "zhHans": "别去那儿！",
    "audio": "audio/7ac68a5d32db1021.m4a"
  },
  {
    "id": "additional-2026-10-29-15-4",
    "zhHans": "你怎么到那儿去了？",
    "audio": "audio/ae821f000ece76a7.m4a"
  },
  {
    "id": "additional-2026-10-29-15-5",
    "zhHans": "这里安全吗？",
    "audio": "audio/a959ffb94ea8ed98.m4a"
  },
  {
    "id": "additional-2026-10-29-15-6",
    "zhHans": "这里很危险！",
    "audio": "audio/e22001103540197e.m4a"
  },
  {
    "id": "additional-2026-10-29-15-7",
    "zhHans": "那里有什么？",
    "audio": "audio/02dc973d88796b9f.m4a"
  },
  {
    "id": "additional-2026-10-29-15-8",
    "zhHans": "那里不安全！",
    "audio": "audio/b2009417c578f78f.m4a"
  },
  {
    "id": "additional-2026-10-29-15-9",
    "zhHans": "你要去哪里？",
    "audio": "audio/132cd52f62ded995.m4a"
  },
  {
    "id": "additional-2026-10-29-15-10",
    "zhHans": "我该去哪里？",
    "audio": "audio/8726c6669fe7aed1.m4a"
  },
  {
    "id": "additional-2026-10-29-15-11",
    "zhHans": "你那儿有棋盘吗？",
    "audio": "audio/7a6bd9f47f4c761d.m4a"
  },
  {
    "id": "additional-2026-10-29-15-12",
    "zhHans": "我这儿有水。",
    "audio": "audio/cbd23a3585003a33.m4a"
  },
  {
    "id": "additional-2026-10-29-15-13",
    "zhHans": "你朋友那儿还有人吗？",
    "audio": "audio/c99ba7cf605b38b9.m4a"
  },
  {
    "id": "additional-2026-10-29-16-1",
    "zhHans": "你非常聪明！",
    "audio": "audio/c9d79bd3aa99e341.m4a"
  },
  {
    "id": "additional-2026-10-29-16-2",
    "zhHans": "你非常厉害！",
    "audio": "audio/841acc983ef3ecb5.m4a"
  },
  {
    "id": "additional-2026-10-29-16-3",
    "zhHans": "今天比较热。",
    "audio": "audio/ad478964c1d0a5c3.m4a"
  },
  {
    "id": "additional-2026-10-29-16-4",
    "zhHans": "这局比较难。",
    "audio": "audio/759e63302f5e05ea.m4a"
  },
  {
    "id": "additional-2026-10-29-16-5",
    "zhHans": "我有点儿紧张。",
    "audio": "audio/7e39360a5a015743.m4a"
  },
  {
    "id": "additional-2026-10-29-16-6",
    "zhHans": "我有点儿害怕。",
    "audio": "audio/2b602a92075bd374.m4a"
  },
  {
    "id": "additional-2026-10-29-16-7",
    "zhHans": "我有点儿累了。",
    "audio": "audio/14ea67725f0a7f5f.m4a"
  },
  {
    "id": "additional-2026-10-29-17-1",
    "zhHans": "我不开心。",
    "audio": "audio/2e030b7455f6237f.m4a"
  },
  {
    "id": "additional-2026-10-29-17-2",
    "zhHans": "我不害怕！",
    "audio": "audio/178747487a85e242.m4a"
  },
  {
    "id": "additional-2026-10-29-17-3",
    "zhHans": "我不很高兴。",
    "audio": "audio/277d8188f955c8d7.m4a"
  },
  {
    "id": "additional-2026-10-29-17-4",
    "zhHans": "我很不高兴！",
    "audio": "audio/3cf888801c2f0f34.m4a"
  },
  {
    "id": "additional-2026-10-29-17-5",
    "zhHans": "今天不很冷。",
    "audio": "audio/1353750b8a6caf76.m4a"
  },
  {
    "id": "additional-2026-10-29-17-6",
    "zhHans": "你太快了！",
    "audio": "audio/9c7b1c6f82bcf13a.m4a"
  },
  {
    "id": "additional-2026-10-29-17-7",
    "zhHans": "这太危险了！",
    "audio": "audio/18d6ba4a668eccb1.m4a"
  },
  {
    "id": "additional-2026-10-29-18-1",
    "zhHans": "你忙不忙？",
    "audio": "audio/e7a35549e5c92584.m4a"
  },
  {
    "id": "additional-2026-10-29-18-2",
    "zhHans": "你紧张不紧张？",
    "audio": "audio/688f9a773b564fb9.m4a"
  },
  {
    "id": "additional-2026-10-29-18-3",
    "zhHans": "你累不累？",
    "audio": "audio/dcc4053eba3a77fc.m4a"
  },
  {
    "id": "additional-2026-10-29-18-4",
    "zhHans": "这一步难不难？",
    "audio": "audio/f3ea41a6c40f0cde.m4a"
  },
  {
    "id": "additional-2026-10-29-18-5",
    "zhHans": "这局有多难？",
    "audio": "audio/5460104a2813956d.m4a"
  },
  {
    "id": "additional-2026-10-29-18-6",
    "zhHans": "你觉得这局怎么样？",
    "audio": "audio/ebe9e51e589b4fd0.m4a"
  },
  {
    "id": "additional-2026-10-29-19-1",
    "zhHans": "这是一个很好的办法。",
    "audio": "audio/92c8a2bb1ce122b6.m4a"
  },
  {
    "id": "additional-2026-10-29-19-2",
    "zhHans": "你是一个很强的对手。",
    "audio": "audio/ae3e5c554b8d074e.m4a"
  },
  {
    "id": "additional-2026-10-29-19-3",
    "zhHans": "今天是非常重要的一天。",
    "audio": "audio/1d61556c94a2d55d.m4a"
  },
  {
    "id": "additional-2026-10-29-19-4",
    "zhHans": "这是一个非常好的主意！",
    "audio": "audio/38920e92dc44b804.m4a"
  },
  {
    "id": "additional-2026-10-29-19-5",
    "zhHans": "这是一场挺有意思的比赛。",
    "audio": "audio/1e042495d83a1934.m4a"
  },
  {
    "id": "additional-2026-10-29-20-1",
    "zhHans": "我想喝热热的茶。",
    "audio": "audio/441f6b4b600ac38b.m4a"
  },
  {
    "id": "additional-2026-10-29-20-2",
    "zhHans": "我的小小的梦想破灭了。",
    "audio": "audio/79a03472b4e71eb9.m4a"
  },
  {
    "id": "additional-2026-10-29-21-1",
    "zhHans": "这是你想的办法吗？",
    "audio": "audio/cd397ba1bdcd7a13.m4a"
  },
  {
    "id": "additional-2026-10-29-21-2",
    "zhHans": "这是我写的书。",
    "audio": "audio/f3ecf98b8427c02f.m4a"
  },
  {
    "id": "additional-2026-10-29-22-1",
    "zhHans": "我有很多问题！",
    "audio": "audio/a49f44f011b9869f.m4a"
  },
  {
    "id": "additional-2026-10-29-22-2",
    "zhHans": "你有不少好办法！",
    "audio": "audio/b05e7d332aef9318.m4a"
  },
  {
    "id": "additional-2026-10-29-22-3",
    "zhHans": "今天学了很多东西。",
    "audio": "audio/b7e192dfcb6d515d.m4a"
  },
  {
    "id": "additional-2026-10-29-22-4",
    "zhHans": "我还有很多要学的东西。",
    "audio": "audio/1f3f32bb04bca4b1.m4a"
  },
  {
    "id": "additional-2026-10-29-23-1",
    "zhHans": "这局不很难。",
    "audio": "audio/1b5060719bb8514e.m4a"
  },
  {
    "id": "translated-1-1",
    "zhHans": "他被关进监狱了。",
    "audio": "audio/9cd0282b507fbd2d.m4a"
  },
  {
    "id": "translated-1-2",
    "zhHans": "我在打扫房间。",
    "audio": "audio/4731f9eca9129ff3.m4a"
  },
  {
    "id": "translated-1-3",
    "zhHans": "我在收拾桌上的东西。",
    "audio": "audio/9da3ed3cf78aba5f.m4a"
  },
  {
    "id": "translated-2-1",
    "zhHans": "可惜，兵消失了。",
    "audio": "audio/89dd815cf2933f5d.m4a"
  },
  {
    "id": "translated-2-2",
    "zhHans": "那可是我喜欢的兵！",
    "audio": "audio/3248d7ed64f30cb7.m4a"
  },
  {
    "id": "translated-2-3",
    "zhHans": "他们只是我的手和脚。",
    "audio": "audio/4018c18fadbccda3.m4a"
  },
  {
    "id": "translated-3-1",
    "zhHans": "再见了。",
    "audio": "audio/f6a07d1b51af7ef8.m4a"
  },
  {
    "id": "translated-4-1",
    "zhHans": "我那匹可爱的马啊！",
    "audio": "audio/8ce392be5e618aee.m4a"
  },
  {
    "id": "translated-4-2",
    "zhHans": "我刚买了它！",
    "audio": "audio/d787aebba656ee0e.m4a"
  },
  {
    "id": "translated-5-1",
    "zhHans": "呼，热起来了！",
    "audio": "audio/e3d35ded8894a588.m4a"
  },
  {
    "id": "translated-6-1",
    "zhHans": "再见了。",
    "audio": "audio/f6a07d1b51af7ef8.m4a"
  },
  {
    "id": "translated-7-1",
    "zhHans": "你累了吗？",
    "audio": "audio/f550c4692eee71b3.m4a"
  },
  {
    "id": "translated-7-2",
    "zhHans": "再见了。",
    "audio": "audio/f6a07d1b51af7ef8.m4a"
  },
  {
    "id": "translated-7-3",
    "zhHans": "我攻下了移动的城堡！",
    "audio": "audio/80162729ae5a3a89.m4a"
  },
  {
    "id": "translated-7-4",
    "zhHans": "你的车？我给你洗！",
    "audio": "audio/4110d0468b6fff4e.m4a"
  },
  {
    "id": "translated-8-1",
    "zhHans": "喝杯咖啡，冷静一下。",
    "audio": "audio/f92844f68ce3aa2b.m4a"
  },
  {
    "id": "translated-8-2",
    "zhHans": "喝点水，冷静一下。",
    "audio": "audio/f29aead06152d5ef.m4a"
  },
  {
    "id": "translated-9-1",
    "zhHans": "别生气啊！",
    "audio": "audio/1bd1933e5c5a2543.m4a"
  },
  {
    "id": "translated-9-2",
    "zhHans": "再见了。",
    "audio": "audio/f6a07d1b51af7ef8.m4a"
  },
  {
    "id": "translated-9-3",
    "zhHans": "怎么了？脸都白了！",
    "audio": "audio/1a2db046000ba431.m4a"
  },
  {
    "id": "translated-9-4",
    "zhHans": "我胸口很疼。",
    "audio": "audio/b83f2c745f47037f.m4a"
  },
  {
    "id": "translated-9-5",
    "zhHans": "王后……死了……",
    "audio": "audio/924f4fea1a5b3653.m4a"
  },
  {
    "id": "translated-10-1",
    "zhHans": "我想回家了。",
    "audio": "audio/d5d297f962d56ae6.m4a"
  },
  {
    "id": "translated-10-2",
    "zhHans": "我快哭了。",
    "audio": "audio/31c449ce9d43a234.m4a"
  },
  {
    "id": "translated-10-3",
    "zhHans": "啊，头好疼。",
    "audio": "audio/e06d8c4c6929b93f.m4a"
  },
  {
    "id": "translated-10-4",
    "zhHans": "王后……死了……",
    "audio": "audio/924f4fea1a5b3653.m4a"
  },
  {
    "id": "translated-10-5",
    "zhHans": "你有一颗冰冷的心！",
    "audio": "audio/b6c5dd73c6461cbc.m4a"
  },
  {
    "id": "translated-11-1",
    "zhHans": "这局真好玩！",
    "audio": "audio/8387c08adbe5a7ab.m4a"
  },
  {
    "id": "translated-12-1",
    "zhHans": "你是白方。",
    "audio": "audio/c172d8a7ab8d1427.m4a"
  },
  {
    "id": "translated-12-2",
    "zhHans": "我是黑方。",
    "audio": "audio/0961d34416b28b3b.m4a"
  },
  {
    "id": "translated-13-1",
    "zhHans": "你是黑方。",
    "audio": "audio/1afc69b8a59a6831.m4a"
  },
  {
    "id": "translated-13-2",
    "zhHans": "我是白方。",
    "audio": "audio/41850b76e5bf903d.m4a"
  },
  {
    "id": "translated-14-1",
    "zhHans": "听说国际象棋起源于印度。",
    "audio": "audio/0cb8d3916cd17617.m4a"
  },
  {
    "id": "translated-14-2",
    "zhHans": "我们下棋吧！",
    "audio": "audio/47d4e1c0618fea3f.m4a"
  },
  {
    "id": "translated-14-3",
    "zhHans": "你是白方。",
    "audio": "audio/c172d8a7ab8d1427.m4a"
  },
  {
    "id": "translated-14-4",
    "zhHans": "你是黑方。",
    "audio": "audio/1afc69b8a59a6831.m4a"
  },
  {
    "id": "translated-14-5",
    "zhHans": "我是白方。",
    "audio": "audio/41850b76e5bf903d.m4a"
  },
  {
    "id": "translated-14-6",
    "zhHans": "我是黑方。",
    "audio": "audio/0961d34416b28b3b.m4a"
  },
  {
    "id": "translated-14-7",
    "zhHans": "你怕输吗？",
    "audio": "audio/16d2ecb85e8a2831.m4a"
  },
  {
    "id": "translated-14-8",
    "zhHans": "我一定会赢！",
    "audio": "audio/274e9bcf450383dc.m4a"
  },
  {
    "id": "translated-14-9",
    "zhHans": "欢迎来到国际象棋学校！",
    "audio": "audio/12b6d2b014b45f48.m4a"
  },
  {
    "id": "translated-14-10",
    "zhHans": "我们开始吧！",
    "audio": "audio/e30da118200ed26a.m4a"
  },
  {
    "id": "translated-14-11",
    "zhHans": "我是老师，你是学生。",
    "audio": "audio/c5ef538e649bec4e.m4a"
  },
  {
    "id": "translated-15-1",
    "zhHans": "我去找国王了！",
    "audio": "audio/cdf51cf0e1effe4e.m4a"
  },
  {
    "id": "translated-15-2",
    "zhHans": "你逃不掉了！",
    "audio": "audio/10a5d92525807b31.m4a"
  },
  {
    "id": "translated-15-3",
    "zhHans": "小心背后！",
    "audio": "audio/00a03d95841462b1.m4a"
  },
  {
    "id": "translated-16-1",
    "zhHans": "陛下要过来了！让路！",
    "audio": "audio/57674ce4e08af055.m4a"
  },
  {
    "id": "translated-16-2",
    "zhHans": "别过来！",
    "audio": "audio/7efd8f0c0f0e8708.m4a"
  },
  {
    "id": "translated-16-3",
    "zhHans": "这是叛乱！",
    "audio": "audio/2584006fd51cc7ec.m4a"
  },
  {
    "id": "translated-17-1",
    "zhHans": "赢了，开心吗？太好了！",
    "audio": "audio/5923c36579569890.m4a"
  },
  {
    "id": "translated-17-2",
    "zhHans": "国破山河在。",
    "audio": "audio/82b7aae3ca1b4927.m4a"
  },
  {
    "id": "translated-17-3",
    "zhHans": "我讨厌输。",
    "audio": "audio/6e958d714816c8f1.m4a"
  },
  {
    "id": "translated-17-4",
    "zhHans": "你比我强！",
    "audio": "audio/4f6b2c374057f040.m4a"
  },
  {
    "id": "translated-17-5",
    "zhHans": "别告诉我妈妈！",
    "audio": "audio/5d16ea9f296ba9a3.m4a"
  },
  {
    "id": "translated-17-6",
    "zhHans": "别告诉我爸爸！",
    "audio": "audio/47cc05013aed3fb5.m4a"
  },
  {
    "id": "translated-17-7",
    "zhHans": "明天我会赢！",
    "audio": "audio/16641c25bb61401d.m4a"
  },
  {
    "id": "translated-18-1",
    "zhHans": "借你一本棋书？",
    "audio": "audio/fead5afe38275958.m4a"
  },
  {
    "id": "translated-18-2",
    "zhHans": "比赛结束了。",
    "audio": "audio/02f6365aaf10bc6d.m4a"
  },
  {
    "id": "translated-18-3",
    "zhHans": "弱一点也没关系。",
    "audio": "audio/498086e9151d3b0a.m4a"
  },
  {
    "id": "translated-18-4",
    "zhHans": "不甘心吗？",
    "audio": "audio/0aa04156b47a291c.m4a"
  },
  {
    "id": "translated-18-5",
    "zhHans": "真该录个视频！",
    "audio": "audio/b024b1234a97e4ff.m4a"
  },
  {
    "id": "translated-18-6",
    "zhHans": "明天再下吧！",
    "audio": "audio/803056aecf8a0ead.m4a"
  },
  {
    "id": "translated-19-1",
    "zhHans": "你看到了吗？",
    "audio": "audio/e43c94276da430fd.m4a"
  },
  {
    "id": "translated-19-2",
    "zhHans": "王侯将相，宁有种乎！",
    "audio": "audio/303e35c7c5810a59.m4a"
  },
  {
    "id": "translated-20-1",
    "zhHans": "〇〇出现了！",
    "audio": "audio/3fc306b21cff053e.m4a"
  },
  {
    "id": "translated-20-2",
    "zhHans": "王后回来了！",
    "audio": "audio/496e3e4525772a51.m4a"
  },
  {
    "id": "translated-21-1",
    "zhHans": "我不会放弃！",
    "audio": "audio/5ab736887d9361bb.m4a"
  },
  {
    "id": "translated-21-2",
    "zhHans": "救命！",
    "audio": "audio/88c3a425e5e7d13d.m4a"
  },
  {
    "id": "translated-21-3",
    "zhHans": "借我手机！我要打电话求救！",
    "audio": "audio/56224bb6fb397614.m4a"
  },
  {
    "id": "translated-22-1",
    "zhHans": "只剩你一个了。",
    "audio": "audio/6097bf2adf007587.m4a"
  },
  {
    "id": "translated-22-2",
    "zhHans": "寂寞吗？",
    "audio": "audio/dcbf2ab48a45cd69.m4a"
  },
  {
    "id": "translated-22-3",
    "zhHans": "陛下，您寂寞吗？",
    "audio": "audio/b4a6c4eac12cf733.m4a"
  },
  {
    "id": "translated-23-1",
    "zhHans": "早上好！",
    "audio": "audio/2210c6b552a0c1b6.m4a"
  },
  {
    "id": "translated-23-2",
    "zhHans": "你起得真早！",
    "audio": "audio/13900a5c9fb8744f.m4a"
  },
  {
    "id": "translated-23-3",
    "zhHans": "外面很亮。",
    "audio": "audio/4e121f62cf85541c.m4a"
  },
  {
    "id": "translated-24-1",
    "zhHans": "晚上好！",
    "audio": "audio/20d9b4c95498e0df.m4a"
  },
  {
    "id": "translated-24-2",
    "zhHans": "现在？你不困吗？",
    "audio": "audio/2269b9c8e0278272.m4a"
  },
  {
    "id": "translated-24-3",
    "zhHans": "你睡得真晚！",
    "audio": "audio/20e4a9a1c5f1fd42.m4a"
  },
  {
    "id": "translated-24-4",
    "zhHans": "外面已经黑了。",
    "audio": "audio/bcd02d7d09354e30.m4a"
  },
  {
    "id": "translated-24-5",
    "zhHans": "现在几点了？",
    "audio": "audio/81e885da8e95543f.m4a"
  },
  {
    "id": "translated-25-1",
    "zhHans": "陛下进城堡了！",
    "audio": "audio/e05b81f333a9b6ab.m4a"
  },
  {
    "id": "translated-26-1",
    "zhHans": "陛下，请出来！",
    "audio": "audio/7804ec5bd37cd834.m4a"
  },
  {
    "id": "translated-27-1",
    "zhHans": "又见面了！",
    "audio": "audio/01a958c8110711b7.m4a"
  },
  {
    "id": "translated-27-2",
    "zhHans": "今天都见你好几次了！",
    "audio": "audio/f4e2f10dca272207.m4a"
  },
  {
    "id": "translated-28-1",
    "zhHans": "真快！",
    "audio": "audio/858fb5e3f30256af.m4a"
  },
  {
    "id": "translated-28-2",
    "zhHans": "太快了！",
    "audio": "audio/c1070f8340d434db.m4a"
  },
  {
    "id": "translated-29-1",
    "zhHans": "形势逆转了！",
    "audio": "audio/9ac6628be01bc572.m4a"
  },
  {
    "id": "translated-30-1",
    "zhHans": "求你了，等一下！",
    "audio": "audio/6476339def1ce083.m4a"
  },
  {
    "id": "translated-31-1",
    "zhHans": "小时候，爷爷教过我。",
    "audio": "audio/8187c35b0aff4b31.m4a"
  },
  {
    "id": "translated-31-2",
